diff --git a/scripts/constitution_compliance.py b/scripts/constitution_compliance.py
new file mode 100644
index 00000000..cc3fdb21
--- /dev/null
+++ b/scripts/constitution_compliance.py
@@ -0,0 +1,120 @@
+"""Run the repository's free/open-source/self-hosted compliance checks."""
+from __future__ import annotations
+
+import pathlib
+import re
+import sys
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+PAID_PATTERNS = [
+    r"(openai|anthropic|google\.ai|aws|azure|gcp)\.(com|io)",
+    r"stripe\.com", r"twilio\.com", r"sendgrid\.net",
+    r"auth0\.com", r"okta\.com", r"supabase\.(co|com)",
+    r"firebase\.(io|googleapis\.com)",
+]
+SAAS_REFS = [
+    r"supabase\.(co|com)", r"firebase\.(io|googleapis)",
+    r"auth0\.com", r"okta\.com", r"aws\.amazon\.com",
+    r"azure\.microsoft\.com", r"cloud\.google\.com",
+    r"mongodb\.com/atlas", r"datadog\.com", r"newrelic\.com",
+    r"sendgrid\.(net|com)", r"twilio\.com", r"pagerduty\.com",
+]
+VENDOR_SDKS = [
+    (r"import\s+boto3", "AWS SDK (boto3)"),
+    (r"from\s+boto3", "AWS SDK (boto3)"),
+    (r"from\s+azure\.", "Azure SDK"),
+    (r"import\s+azure\.", "Azure SDK"),
+    (r"from\s+google\.cloud", "GCP SDK"),
+    (r"import\s+google\.cloud", "GCP SDK"),
+    (r"import\s+supabase", "Supabase SDK"),
+    (r"from\s+supabase", "Supabase SDK"),
+    (r"import\s+auth0", "Auth0 SDK"),
+    (r"from\s+auth0", "Auth0 SDK"),
+    (r"import\s+okta", "Okta SDK"),
+    (r"from\s+okta", "Okta SDK"),
+    (r"import\s+stripe", "Stripe SDK"),
+    (r"from\s+stripe", "Stripe SDK"),
+]
+
+
+def files(*patterns: str):
+    for pattern in patterns:
+        yield from ROOT.rglob(pattern)
+
+
+def check_free_first() -> bool:
+    issues: list[str] = []
+    for path in files("requirements*.txt", "package.json"):
+        if "node_modules" in path.parts:
+            continue
+        text = path.read_text(errors="ignore")
+        for pattern in PAID_PATTERNS:
+            if re.search(pattern, text, re.I):
+                issues.append(f"{path.relative_to(ROOT)}: {pattern}")
+    for issue in issues:
+        print(f"WARNING: {issue}")
+    print("Free First: WARN" if issues else "Free First: PASS")
+    return True
+
+
+def check_open_source() -> bool:
+    proprietary = ("commercial", "proprietary", "all rights reserved", "eula", "enterprise license")
+    issues: list[str] = []
+    for path in files("requirements*.txt", "package.json"):
+        if "node_modules" in path.parts:
+            continue
+        text = path.read_text(errors="ignore").lower()
+        for license_name in proprietary:
+            if license_name in text:
+                issues.append(f"{path.relative_to(ROOT)}: {license_name}")
+    for issue in issues:
