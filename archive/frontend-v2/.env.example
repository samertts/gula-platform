# ─── GULA Frontend env template (Vite — all browser-visible vars MUST be VITE_*) ───

# Google AI Studio (legacy — server-side calls now go through backend gateway)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Where this applet is hosted (self-referential links, OAuth callbacks).
APP_URL="MY_APP_URL"

# ─── Environment ───────────────────────────────────────────────────
VITE_APP_ENV=development
VITE_APP_VERSION=2.1.0

# ─── API ───────────────────────────────────────────────────────────
# API base (relative — Vercel rewrites /api/* to api.gula-platform.org).
# Override only for local dev (e.g. http://localhost:8000/api).
VITE_API_BASE=/api
VITE_USE_MOCK=false

# ─── Demo Mode ─────────────────────────────────────────────────────
VITE_DEMO_MODE=false
VITE_DEMO_BANNER=true

# ─── Feature Flags ─────────────────────────────────────────────────
VITE_FEATURE_AI=true
VITE_FEATURE_OCR=true
VITE_FEATURE_FHIR=true
VITE_FEATURE_NOTIFICATIONS=true
VITE_FEATURE_ANALYTICS=true
VITE_FEATURE_KNOWLEDGE_GRAPH=true
VITE_FEATURE_EXPERIMENTAL=false

# ─── Telemetry (leave blank to disable) ────────────────────────────
# PostHog — product analytics + funnel/session metrics.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
# Sentry — frontend exception tracking. Use the DSN, never the auth token.
VITE_SENTRY_DSN=
VITE_TELEMETRY_DISABLED=false
