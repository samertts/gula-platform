{
  "name": "gula-platform",
  "version": "1.0.0",
  "description": "Revolutionary Healthcare Laboratory Management System",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/_core/index.ts",
    "build": "tsc && vite build",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "db:migrate": "drizzle-kit generate:mysql && drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:push": "drizzle-kit push:mysql",
    "db:studio": "drizzle-kit studio",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.18.2",
    "@trpc/server": "^10.45.0",
    "@trpc/client": "^10.45.0",
    "@trpc/react-query": "^10.45.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "tailwindcss": "^3.4.0",
    "mysql2": "^3.6.5",
    "drizzle-orm": "^0.36.4",
    "redis": "^4.6.12",
    "zod": "^3.22.4",
    "@tanstack/react-query": "^5.28.0",
    "@tanstack/react-query-devtools": "^5.28.0",
    "jsonwebtoken": "^9.0.3",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "axios": "^1.8.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "uuid": "^9.0.1",
    "superjson": "^2.2.1",
    "date-fns": "^2.30.0",
    "clsx": "^2.0.0",
    "class-variance-authority": "^0.7.0",
    "lodash": "^4.17.21",
    "recharts": "^2.10.3",
    "lucide-react": "^0.344.0",
    "framer-motion": "^10.16.16",
    "@types/uuid": "^9.0.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/uuid": "^9.0.7",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/lodash": "^4.14.202",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "vite": "^5.4.21",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitejs/plugin-basic-ssl": "^1.0.1",
    "vitest": "^1.0.4",
    "@vitest/ui": "^1.1.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "drizzle-kit": "^0.27.0",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "shadcn-ui": "^0.8.0",
    "postcss": "^8.4.32",
    "autoprefixer": "^10.4.16",
    "@types/react-router-dom": "^5.3.3",
    "@testing-library/react": "^14.1.2",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/user-event": "^14.5.1",
    "@vitest/coverage-v8": "^1.0.4",
    "@types/jest": "^29.5.11",
    "vitest-mock-extended": "^1.3.2",
    "@types/node": "^20.10.6"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "keywords": [
    "healthcare",
    "laboratory",
    "management",
    "lims",
    "medical",
    "iraq",
    "mena"
  ],
  "author": "GULA Platform Team",
  "license": "PROPRIETARY",
  "pnpm": {
    "overrides": {
      "esbuild": "0.27.6",
      "minimatch": "10.0.3"
    }
  },
  "resolutions": {
    "minimatch": ">=9.0.5",
    "esbuild": ">=0.25.0",
    "axios": ">=1.8.2",
    "lodash": ">=4.17.21",
    "hono": ">=4.7.7",
    "@hono/node-server": ">=1.13.8"
  }
}
