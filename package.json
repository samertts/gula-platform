{
  "name": "gula-platform",
  "version": "1.0.0",
  "description": "Revolutionary Healthcare Laboratory Management System",
  "main": "dist/server/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc && vite build",
    "build:frontend": "npm --prefix frontend-v3 run build",
    "start": "node dist/server/index.js",
    "dev:frontend": "npm --prefix frontend-v3 run dev",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "type-check:frontend": "npm --prefix frontend-v3 run typecheck"
  },
  "dependencies": {
    "express": "^5.2.1",
    "@trpc/server": "^11.18.0",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3",
    "redis": "^4.7.0",
    "zod": "^4.4.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "jsonwebtoken": "^9.0.3",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.0",
    "axios": "^1.8.2",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "compression": "^1.8.0",
    "uuid": "^14.0.0",
    "superjson": "^2.2.1",
    "date-fns": "^4.4.0",
    "clsx": "^2.1.1",
    "class-variance-authority": "^0.7.1",
    "lodash": "^4.17.21",
    "recharts": "^3.10.0",
    "lucide-react": "^1.25.0",
    "framer-motion": "^12.42.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/lodash": "^4.17.0",
    "typescript": "^7.0.2",
    "tsx": "^4.19.0",
    "vite": "^8.1.5",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "vitest": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.7.0",
    "prettier": "^3.9.6",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "shadcn-ui": "^0.9.0",
    "postcss": "^8.5.26",
    "autoprefixer": "^10.4.16",
    "@testing-library/react": "^16.3.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/user-event": "^14.6.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@types/jest": "^29.5.11",
    "vitest-mock-extended": "^4.0.0",
    "@types/node": "^22.14.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "healthcare",
    "laboratory",
    "management",
    "lims",
    "medical",
    "iraq",
