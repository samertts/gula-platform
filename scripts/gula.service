[Unit]
Description=GULA Clinical Platform (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=samertts
WorkingDirectory=/home/samertts/gula-platform
# Pull is skipped (we build locally); only start what's already built
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down --timeout 30
ExecReload=/usr/bin/docker compose up -d --remove-orphans
Restart=on-failure
RestartSec=15s
TimeoutStartSec=300
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gula-platform

[Install]
WantedBy=multi-user.target
