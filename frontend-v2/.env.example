# ─── GULA Frontend env template (Vite — all browser-visible vars MUST be VITE_*) ───

# Google AI Studio (legacy — server-side calls now go through backend gateway)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Where this applet is hosted (self-referential links, OAuth callbacks).
APP_URL="MY_APP_URL"

# ─── Phase 2 telemetry ──────────────────────────────────────────────────────
# Leaving any of these BLANK disables the corresponding SDK entirely — no
# network requests, no bundle bloat, no console errors.
#
# PostHog — product analytics + funnel/session metrics. Use a PUBLIC project
# key (not the personal/private one). Self-host or use cloud.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Sentry — frontend exception tracking. Use the DSN, never the auth token.
VITE_SENTRY_DSN=

# Optional release/environment tags for both SDKs.
VITE_APP_VERSION=2.1.0
VITE_APP_ENV=production

# API base (relative — Vercel rewrites /api/* to api.gula-platform.org).
# Override only for local dev (e.g. http://localhost:8000/api).
VITE_API_BASE=/api
