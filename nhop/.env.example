# ============================================================
# NHOP Platform - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nhop
DB_USER=postgres
DB_PASS=your_secure_password_here
DB_POOL_MAX=10

# JWT Authentication - MUST change in production!
JWT_SECRET=change-this-to-a-very-long-random-string-in-production
JWT_EXPIRES=8h
REFRESH_EXPIRES=30d

# CORS - comma separated allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# Critical value thresholds (optional - defaults apply)
# CRITICAL_GLU_HIGH=400
# CRITICAL_HGB_LOW=7
# CRITICAL_PLT_LOW=50
# CRITICAL_WBC_HIGH=30
