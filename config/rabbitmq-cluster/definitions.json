  "policies": [
    {
      "name": "ha-all",
      "pattern": ".*",
      "vhost": "gula",
      "definition": {
        "ha-mode": "all",
        "ha-sync-mode": "automatic",
        "ha-promote-on-shutdown": "when-synced"
      },
      "priority": 100,
      "apply-to": "all"
    },
    {
      "name": "expiry",
      "pattern": ".*\\.events\\.q",
      "vhost": "gula",
      "definition": {
        "expires": 2592000000,
        "message-ttl": 86400000
      },
      "priority": 50,
      "apply-to": "queues"
    },
    {
      "name": "max-length",
      "pattern": ".*\\.events\\.q",
      "vhost": "gula",
      "definition": {
        "max-length": 200000,
        "overflow": "reject-publish"
      },
      "priority": 50,
      "apply-to": "queues"
    },
    {
      "name": "quorum-queues",
      "pattern": ".*",
      "vhost": "gula",
      "definition": {
        "queue-type": "quorum"
      },
      "priority": 1,
      "apply-to": "queues"
    }
  ],
  "parameters": [],
  "global_parameters": [
    {
      "name": "internal_cluster_id",
      "value": "gula_rabbitmq_cluster_2026"
    }
  ]
