{
  "_comment": "GULA Platform — RabbitMQ Cluster Definitions. Import via management plugin or load_definitions. Supports ha-mode=all with automatic sync.",
  "rabbit_version": "3.13",
  "rabbitmq_version": "3.13",
  "product_name": "RabbitMQ",
  "users": [
    {
      "name": "gula",
      "password_hash": "{{GULA_RABBIT_PASSWORD_HASH}}",
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "tags": "administrator"
    },
    {
      "name": "gula_app",
      "password_hash": "{{GULA_APP_RABBIT_PASSWORD_HASH}}",
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "tags": "management"
    },
    {
      "name": "gula_monitor",
      "password_hash": "{{GULA_MONITOR_RABBIT_PASSWORD_HASH}}",
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "tags": "monitoring"
    }
  ],
  "vhosts": [
    {
      "name": "gula"
    },
    {
      "name": "gula_dr"
    }
  ],
  "permissions": [
    {
      "user": "gula",
      "vhost": "gula",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    },
    {
      "user": "gula_app",
      "vhost": "gula",
      "configure": "^(order|result|notification|audit)\\.(events|dlq|retry)$",
      "write": "^(order|result|notification|audit)\\.(events|dlq|retry)$",
      "read": "^(order|result|notification|audit)\\.(events|dlq|retry)$"
    },
    {
      "user": "gula_monitor",
      "vhost": "gula",
      "configure": "^amq\\.gen.*$",
      "write": "^amq\\.default$",
      "read": "^(order|result|notification|audit)\\..*$"
    },
    {
      "user": "gula",
      "vhost": "gula_dr",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "exchanges": [
    {
      "name": "order.events",
      "vhost": "gula",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {
        "alternate-exchange": "order.unroutable"
      }
    },
    {
      "name": "result.events",
      "vhost": "gula",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {
        "alternate-exchange": "result.unroutable"
      }
    },
    {
      "name": "notification.events",
      "vhost": "gula",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {
        "alternate-exchange": "notification.unroutable"
      }
    },
    {
      "name": "audit.events",
      "vhost": "gula",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {
        "alternate-exchange": "audit.unroutable"
      }
    },
    {
      "name": "order.unroutable",
      "vhost": "gula",
      "type": "fanout",
      "durable": true,
      "auto_delete": false,
      "internal": true,
      "arguments": {}
    },
    {
      "name": "result.unroutable",
      "vhost": "gula",
      "type": "fanout",
      "durable": true,
      "auto_delete": false,
      "internal": true,
      "arguments": {}
    },
    {
      "name": "notification.unroutable",
      "vhost": "gula",
      "type": "fanout",
      "durable": true,
      "auto_delete": false,
      "internal": true,
      "arguments": {}
    },
    {
      "name": "audit.unroutable",
      "vhost": "gula",
      "type": "fanout",
      "durable": true,
      "auto_delete": false,
      "internal": true,
      "arguments": {}
    },
    {
      "name": "gula.dlx",
      "vhost": "gula",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "gula.retry",
      "vhost": "gula",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "order.events.q",
      "vhost": "gula",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-dead-letter-exchange": "gula.dlx",
        "x-dead-letter-routing-key": "order.events.dlq",
        "x-message-ttl": 86400000,
        "x-max-length": 100000,
        "x-overflow": "reject-publish"
      }
    },
    {
      "name": "order.events.dlq",
      "vhost": "gula",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-message-ttl": 604800000,
        "x-max-length": 10000
      }
    },
    {
      "name": "order.events.retry",
      "vhost": "gula",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-dead-letter-exchange": "order.events",
        "x-dead-letter-routing-key": "order.retry",
        "x-message-ttl": 30000,
        "x-max-length": 50000
      }
    },
    {
      "name": "result.events.q",
      "vhost": "gula",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-dead-letter-exchange": "gula.dlx",
        "x-dead-letter-routing-key": "result.events.dlq",
        "x-message-ttl": 86400000,
        "x-max-length": 200000,
        "x-overflow": "reject-publish"
      }
    },
    {
      "name": "result.events.dlq",
      "vhost": "gula",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-message-ttl": 604800000,
        "x-max-length": 10000
      }
    },
    {
      "name": "result.events.retry",
      "vhost": "gula",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-dead-letter-exchange": "result.events",
        "x-dead-letter-routing-key": "result.retry",
        "x-message-ttl": 30000,
        "x-max-length": 50000
      }
    },
    {
      "name": "notification.events.q",
      "vhost": "gula",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-dead-letter-exchange": "gula.dlx",
        "x-dead-letter-routing-key": "notification.events.dlq",
        "x-message-ttl": 3600000,
        "x-max-length": 50000,
        "x-overflow": "reject-publish"
      }
    },
    {
      "name": "notification.events.dlq",
      "vhost": "gula",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-message-ttl": 86400000,
        "x-max-length": 5000
      }
    },
    {
      "name": "notification.events.retry",
      "vhost": "gula",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-dead-letter-exchange": "notification.events",
        "x-dead-letter-routing-key": "notification.retry",
        "x-message-ttl": 15000,
        "x-max-length": 50000
      }
    },
    {
      "name": "audit.events.q",
      "vhost": "gula",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-dead-letter-exchange": "gula.dlx",
        "x-dead-letter-routing-key": "audit.events.dlq",
        "x-message-ttl": 604800000,
        "x-max-length": 500000,
        "x-overflow": "reject-publish"
      }
    },
    {
      "name": "audit.events.dlq",
      "vhost": "gula",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-message-ttl": 2592000000,
        "x-max-length": 50000
      }
    },
    {
      "name": "audit.events.retry",
      "vhost": "gula",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-dead-letter-exchange": "audit.events",
        "x-dead-letter-routing-key": "audit.retry",
        "x-message-ttl": 60000,
        "x-max-length": 10000
      }
    }
  ],
  "bindings": [
