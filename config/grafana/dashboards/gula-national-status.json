{
  "id": null,
  "uid": "gula-national-status",
  "title": "GULA Platform — National Status",
  "description": "National health system status and operations dashboard",
  "tags": ["gula", "national", "status"],
  "timezone": "Asia/Baghdad",
  "refresh": "15s",
  "schemaVersion": 38,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "National Overview",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Overall System Status",
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 5 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "orientation": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "GREEN — All Systems Operational", "color": "green" } } },
            { "type": "value", "options": { "1": { "text": "YELLOW — Minor Degradation", "color": "orange" } } },
            { "type": "value", "options": { "2": { "text": "RED — Major Outage", "color": "red" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          }
        }
      },
      "targets": [
        { "expr": "gula_system_status_code", "legendFormat": "Status" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active Labs",
      "gridPos": { "x": 6, "y": 1, "w": 3, "h": 3 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        { "expr": "gula_active_labs", "legendFormat": "Labs" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Active Hospitals",
      "gridPos": { "x": 9, "y": 1, "w": 3, "h": 3 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        { "expr": "gula_active_hospitals", "legendFormat": "Hospitals" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Patients Served Today",
      "gridPos": { "x": 12, "y": 1, "w": 3, "h": 3 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        { "expr": "increase(gula_patients_served_total[24h])", "legendFormat": "Patients" }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Orders Processed Today",
      "gridPos": { "x": 15, "y": 1, "w": 3, "h": 3 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        { "expr": "increase(gula_orders_processed_total[24h])", "legendFormat": "Orders" }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "System Uptime",
      "gridPos": { "x": 18, "y": 1, "w": 3, "h": 3 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 99.0 },
              { "color": "yellow", "value": 99.5 },
              { "color": "green", "value": 99.9 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        { "expr": "gula_system_uptime_percent", "legendFormat": "Uptime" }
      ]
    },
    {
      "id": 8,
      "type": "gauge",
      "title": "SLA Attainment (30d)",
      "gridPos": { "x": 21, "y": 1, "w": 3, "h": 5 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 95 },
              { "color": "yellow", "value": 99.0 },
              { "color": "green", "value": 99.9 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        { "expr": "gula_sla_attainment_percent", "legendFormat": "SLA" }
      ]
    },
    {
      "id": 9,
      "type": "row",
      "title": "Regional & Service Health",
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 10,
      "type": "table",
      "title": "System Health by Region",
      "gridPos": { "x": 0, "y": 7, "w": 12, "h": 8 },
      "options": {
        "sortBy": [
          { "displayName": "Status", "desc": false }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "HEALTHY", "color": "green" } } },
            { "type": "value", "options": { "1": { "text": "DEGRADED", "color": "orange" } } },
            { "type": "value", "options": { "2": { "text": "DOWN", "color": "red" } } }
          ],
          "min": 0,
          "max": 2
        }
      },
      "targets": [
        {
          "expr": "gula_region_health_status",
          "format": "table",
          "legendFormat": "{{ region }}"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": {
              "region": "Region",
              "Value": "Status",
              "labs_online": "Labs Online",
              "labs_total": "Total Labs"
            }
          }
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Service Latency by Endpoint",
      "gridPos": { "x": 12, "y": 7, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "calcs": ["mean", "max", "last"], "displayMode": "table", "placement": "right" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 200 },
              { "color": "orange", "value": 500 },
              { "color": "red", "value": 1000 }
            ]
          },
          "custom": { "lineWidth": 2 },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        { "expr": "gula_latency_ms{endpoint=\"api\"}", "legendFormat": "API" },
        { "expr": "gula_latency_ms{endpoint=\"db\"}", "legendFormat": "Database" },
        { "expr": "gula_latency_ms{endpoint=\"redis\"}", "legendFormat": "Redis" },
        { "expr": "gula_latency_ms{endpoint=\"device-bridge\"}", "legendFormat": "Device Bridge" }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Error Rate by Service",
      "gridPos": { "x": 0, "y": 15, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "calcs": ["mean", "max", "last"], "displayMode": "table", "placement": "right" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "orange", "value": 5 },
              { "color": "red", "value": 10 }
            ]
          },
          "custom": { "lineWidth": 2 },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        { "expr": "gula_error_rate_percent{service=\"backend\"}", "legendFormat": "Backend" },
        { "expr": "gula_error_rate_percent{service=\"api-gateway\"}", "legendFormat": "API Gateway" },
        { "expr": "gula_error_rate_percent{service=\"device-bridge\"}", "legendFormat": "Device Bridge" },
        { "expr": "gula_error_rate_percent{service=\"worker\"}", "legendFormat": "Worker" }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Degradation Events",
      "gridPos": { "x": 12, "y": 15, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "calcs": ["mean", "max", "last"], "displayMode": "table" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "orange", "value": 3 },
              { "color": "red", "value": 5 }
            ]
          },
          "custom": { "lineWidth": 2, "fillOpacity": 15 },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        { "expr": "increase(gula_degradation_events_total[1h])", "legendFormat": "Degradations" }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "24-Hour Incident Timeline",
      "gridPos": { "x": 0, "y": 23, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "calcs": ["mean", "max", "last"], "displayMode": "table", "placement": "right" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        { "expr": "increase(gula_incidents_total{severity=\"critical\"}[1h])", "legendFormat": "Critical" },
        { "expr": "increase(gula_incidents_total{severity=\"major\"}[1h])", "legendFormat": "Major" },
        { "expr": "increase(gula_incidents_total{severity=\"minor\"}[1h])", "legendFormat": "Minor" }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "National Request Throughput",
      "gridPos": { "x": 12, "y": 23, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "calcs": ["mean", "max", "last"], "displayMode": "table", "placement": "right" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 15 },
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        { "expr": "sum(rate(gula_requests_total[5m]))", "legendFormat": "Total Throughput" }
      ]
    },
    {
      "id": 16,
      "type": "stat",
      "title": "Total Connected Facilities",
      "gridPos": { "x": 0, "y": 31, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        { "expr": "gula_total_connected_facilities", "legendFormat": "Facilities" }
      ]
    },
    {
      "id": 17,
      "type": "stat",
      "title": "Daily Active Users (System-wide)",
      "gridPos": { "x": 4, "y": 31, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        { "expr": "gula_system_dau", "legendFormat": "DAU" }
      ]
    },
    {
      "id": 18,
      "type": "stat",
      "title": "Results Verified Today",
      "gridPos": { "x": 8, "y": 31, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        { "expr": "increase(gula_results_verified_total[24h])", "legendFormat": "Verified" }
      ]
    },
    {
      "id": 19,
      "type": "stat",
      "title": "Pending Verifications",
      "gridPos": { "x": 12, "y": 31, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 200 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        { "expr": "gula_pending_verifications", "legendFormat": "Pending" }
      ]
    },
    {
      "id": 20,
      "type": "stat",
      "title": "National Alert Count",
      "gridPos": { "x": 16, "y": 31, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3 },
              { "color": "orange", "value": 10 },
              { "color": "red", "value": 20 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        { "expr": "gula_national_alert_count", "legendFormat": "Alerts" }
      ]
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Avg System Health Score",
      "gridPos": { "x": 20, "y": 31, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 70 },
              { "color": "yellow", "value": 85 },
              { "color": "green", "value": 95 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        { "expr": "gula_system_health_score", "legendFormat": "Health Score" }
      ]
    }
  ],
  "templating": { "list": [] },
  "links": [],
  "timepicker": {}
}
