{
  "id": null,
  "uid": "gula-main",
  "title": "GULA Platform — Operations",
  "description": "Real-time operational dashboard for GULA Medical Lab Platform",
  "tags": ["gula", "production", "medical"],
  "timezone": "Asia/Baghdad",
  "refresh": "30s",
  "schemaVersion": 38,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Platform Status",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "✅ ONLINE", "color": "green" } } },
            { "type": "value", "options": { "0": { "text": "🔴 DOWN",   "color": "red"   } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",   "value": null },
              { "color": "green", "value": 1    }
            ]
          }
        }
      },
      "targets": [
        { "expr": "gula_up", "legendFormat": "Platform" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Database",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "✅ OK",   "color": "green" } } },
            { "type": "value", "options": { "0": { "text": "🔴 DOWN", "color": "red"   } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",   "value": null },
              { "color": "green", "value": 1    }
            ]
          }
        }
      },
      "targets": [
        { "expr": "gula_db_up", "legendFormat": "Database" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Redis",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "✅ OK",   "color": "green" } } },
            { "type": "value", "options": { "0": { "text": "🟡 DOWN", "color": "orange"} } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "orange", "value": null },
              { "color": "green",  "value": 1    }
            ]
          }
        }
      },
      "targets": [
        { "expr": "gula_redis_up", "legendFormat": "Redis" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Memory RSS",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "MB",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 400  },
              { "color": "red",    "value": 600  }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        { "expr": "gula_memory_rss_mb", "legendFormat": "RSS MB" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Active Requests",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 100  },
              { "color": "red",    "value": 170  }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        { "expr": "gula_active_requests", "legendFormat": "Active" }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Uptime",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        { "expr": "gula_uptime_seconds", "legendFormat": "Uptime" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "DB Latency (ms)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 7 },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 200  },
              { "color": "red",    "value": 500  }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        { "expr": "gula_db_latency_ms",    "legendFormat": "DB ping ms"    },
        { "expr": "gula_redis_latency_ms", "legendFormat": "Redis ping ms" }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Active Requests Over Time",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 7 },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        { "expr": "gula_active_requests", "legendFormat": "Active requests" }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Orders — Total & Pending",
      "gridPos": { "x": 0, "y": 11, "w": 12, "h": 7 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2 },
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        { "expr": "gula_orders_total",   "legendFormat": "Total orders"   },
        { "expr": "gula_orders_pending", "legendFormat": "Pending orders" }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Memory RSS Over Time",
      "gridPos": { "x": 12, "y": 11, "w": 12, "h": 7 },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "MB",
          "custom": { "lineWidth": 2, "fillOpacity": 15 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 400  },
              { "color": "red",    "value": 600  }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        { "expr": "gula_memory_rss_mb", "legendFormat": "RSS MB" }
      ]
    },
    {
      "id": 30,
      "type": "alertlist",
      "title": "Active Alerts",
      "gridPos": { "x": 0, "y": 18, "w": 24, "h": 6 },
      "options": {
        "alertName": "",
        "dashboardAlerts": false,
        "groupMode": "default",
        "maxItems": 20,
        "sortOrder": 1,
        "stateFilter": {
          "firing": true,
          "pending": true,
          "inactive": false
        }
      }
    }
  ],
  "templating": { "list": [] },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  }
}
