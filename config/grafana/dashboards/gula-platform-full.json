          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "targets": [{ "expr": "slo:error_budget_remaining", "legendFormat": "Remaining" }]
    },
    {
      "id": 42,
      "type": "timeseries",
      "title": "Latency SLO (p99)",
      "gridPos": { "x": 16, "y": 63, "w": 8, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 400 },
              { "color": "red", "value": 500 }
            ]
          }
        }
      },
      "targets": [
        { "expr": "slo:latency_p99", "legendFormat": "p99 Latency" },
        { "expr": "500", "legendFormat": "SLO Threshold" }
      ]
    },
    {
      "id": 43,
      "type": "row",
      "title": "Traces",
      "gridPos": { "x": 0, "y": 71, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 44,
      "type": "timeseries",
      "title": "Trace Rate",
      "gridPos": { "x": 0, "y": 72, "w": 6, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [{ "expr": "rate(tempo_spans_total[5m])", "legendFormat": "Spans/sec" }]
    },
    {
      "id": 45,
      "type": "timeseries",
      "title": "P95 Span Duration",
      "gridPos": { "x": 6, "y": 72, "w": 6, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(tempo_span_duration_seconds_bucket[5m])) by (le)) * 1000", "legendFormat": "p95" }]
    },
    {
      "id": 46,
      "type": "timeseries",
      "title": "Error Span Ratio",
      "gridPos": { "x": 12, "y": 72, "w": 6, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "targets": [{ "expr": "sum(rate(tempo_spans_error_total[5m])) / sum(rate(tempo_spans_total[5m]))", "legendFormat": "Error Ratio" }]
    },
    {
      "id": 47,
      "type": "table",
      "title": "Service Dependency Graph",
      "gridPos": { "x": 18, "y": 72, "w": 6, "h": 8 },
      "targets": [
        {
          "expr": "tempo_service_graph_request_total",
          "format": "table",
          "legendFormat": "{{ client }} -> {{ server }}"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "client": "Client", "server": "Server", "Value": "Requests" } } }
      ]
    },
    {
      "id": 48,
      "type": "row",
      "title": "Logs",
      "gridPos": { "x": 0, "y": 80, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 49,
      "type": "timeseries",
      "title": "Log Rate by Level",
      "gridPos": { "x": 0, "y": 81, "w": 8, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        {
          "expr": "rate({service=\"gula-backend\"} |= `\"level\":\"error\"` [5m])",
          "legendFormat": "ERROR",
          "datasource": { "type": "loki", "uid": "loki" }
        },
        {
          "expr": "rate({service=\"gula-backend\"} |= `\"level\":\"warning\"` [5m])",
          "legendFormat": "WARNING",
          "datasource": { "type": "loki", "uid": "loki" }
        },
        {
          "expr": "rate({service=\"gula-backend\"} |= `\"level\":\"info\"` [5m])",
          "legendFormat": "INFO",
          "datasource": { "type": "loki", "uid": "loki" }
        }
      ]
    },
    {
      "id": 50,
      "type": "stat",
      "title": "Error Log Count (1h)",
      "gridPos": { "x": 8, "y": 81, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        {
          "expr": "count_over_time({service=\"gula-backend\"} |= `\"level\":\"error\"` [1h])",
          "datasource": { "type": "loki", "uid": "loki" }
        }
      ]
    },
    {
      "id": 51,
      "type": "logs",
      "title": "Recent Error Logs",
      "gridPos": { "x": 12, "y": 81, "w": 12, "h": 8 },
      "options": {
        "showLabels": true,
        "showTime": true,
        "wrapLogMessage": true,
        "preferLogsSchema": true
      },
      "targets": [
        {
          "expr": "{service=\"gula-backend\"} |= `\"level\":\"error\"` | json",
          "datasource": { "type": "loki", "uid": "loki" }
        }
      ]
    },
    {
      "id": 52,
      "type": "row",
      "title": "RabbitMQ",
      "gridPos": { "x": 0, "y": 89, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 53,
      "type": "timeseries",
      "title": "Queue Depth",
      "gridPos": { "x": 0, "y": 90, "w": 6, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [{ "expr": "rabbitmq_queue_messages_ready", "legendFormat": "Ready" }]
    },
    {
      "id": 54,
      "type": "timeseries",
      "title": "Message Rate",
      "gridPos": { "x": 6, "y": 90, "w": 6, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        { "expr": "rate(rabbitmq_queue_messages_published_total[5m])", "legendFormat": "Published" },
        { "expr": "rate(rabbitmq_queue_messages_delivered_total[5m])", "legendFormat": "Delivered" }
      ]
    },
    {
      "id": 55,
      "type": "stat",
      "title": "Consumer Count",
      "gridPos": { "x": 12, "y": 90, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [{ "expr": "rabbitmq_queue_consumers", "legendFormat": "Consumers" }]
    },
    {
      "id": 56,
      "type": "stat",
      "title": "Unacknowledged",
      "gridPos": { "x": 16, "y": 90, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [{ "expr": "rabbitmq_queue_messages_unacknowledged", "legendFormat": "Unacked" }]
    }
  ]
}
