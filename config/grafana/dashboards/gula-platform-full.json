    {
      "id": 6,
      "type": "stat",
      "title": "Kill Switch",
      "gridPos": { "x": 12, "y": 1, "w": 3, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "INACTIVE", "color": "green" } } },
            { "type": "value", "options": { "1": { "text": "ACTIVE", "color": "red" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [{ "expr": "gula_kill_switch_active", "legendFormat": "Kill Switch" }]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Degradation Level",
      "gridPos": { "x": 15, "y": 1, "w": 3, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "NORMAL", "color": "green" } } },
            { "type": "value", "options": { "1": { "text": "L1_DEGRADED", "color": "orange" } } },
            { "type": "value", "options": { "2": { "text": "L2_READ_ONLY", "color": "red" } } },
            { "type": "value", "options": { "3": { "text": "L3_CRITICAL", "color": "dark-red" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 2 },
              { "color": "dark-red", "value": 3 }
            ]
          }
        }
      },
      "targets": [{ "expr": "gula_degradation_level", "legendFormat": "Degradation" }]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Active Requests",
      "gridPos": { "x": 18, "y": 1, "w": 3, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 150 },
              { "color": "red", "value": 190 }
            ]
          },
          "unit": "short"
        }
      },
      "targets": [{ "expr": "gula_active_requests", "legendFormat": "Active" }]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Pending Orders",
      "gridPos": { "x": 21, "y": 1, "w": 3, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          },
          "unit": "short"
        }
      },
      "targets": [{ "expr": "gula_orders_pending", "legendFormat": "Pending" }]
    },
    {
      "id": 10,
      "type": "row",
      "title": "API Performance",
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Request Rate",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "options": {
        "legend": { "calcs": ["mean", "max", "last"], "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        }
      },
      "targets": [
        { "expr": "sum(rate(gula_requests_total[5m]))", "legendFormat": "Total" },
        { "expr": "sum(rate(gula_request_errors_total[5m]))", "legendFormat": "Errors" }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Latency (p50 / p95 / p99)",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "options": {
        "legend": { "calcs": ["mean", "max", "last"], "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 200 },
              { "color": "red", "value": 500 }
            ]
          }
        }
      },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(gula_request_duration_seconds_bucket[5m])) by (le)) * 1000", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(gula_request_duration_seconds_bucket[5m])) by (le)) * 1000", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(gula_request_duration_seconds_bucket[5m])) by (le)) * 1000", "legendFormat": "p99" }
      ]
    },
    {
      "id": 13,
      "type": "table",
      "title": "Error Rate by Endpoint",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 8 },
      "options": {
        "sortBy": [
          { "displayName": "Error Rate", "desc": true }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "targets": [
        {
          "expr": "sum(rate(gula_request_errors_total[5m])) by (endpoint) / sum(rate(gula_requests_total[5m])) by (endpoint)",
          "legendFormat": "{{ endpoint }}",
          "format": "table"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "Value": false }, "indexByName": {}, "renameByName": { "endpoint": "Endpoint", "Value": "Error Rate" } } }
      ]
    },
    {
      "id": 14,
      "type": "row",
      "title": "Database",
      "gridPos": { "x": 0, "y": 22, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
