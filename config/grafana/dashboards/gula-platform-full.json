      "title": "DB Query Latency",
      "gridPos": { "x": 6, "y": 23, "w": 6, "h": 8 },
      "options": {
        "legend": { "calcs": ["mean", "max", "last"], "displayMode": "table" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          }
        }
      },
      "targets": [
        { "expr": "gula_db_latency_ms", "legendFormat": "Latency" }
      ]
