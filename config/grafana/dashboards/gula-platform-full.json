      "title": "Cache Hit Ratio",
      "gridPos": { "x": 12, "y": 23, "w": 6, "h": 8 },
      "options": {
        "legend": { "calcs": ["mean", "max", "last"], "displayMode": "table" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "targets": [
        { "expr": "rate(pg_stat_database_blks_hit[5m]) / (rate(pg_stat_database_blks_hit[5m]) + rate(pg_stat_database_blks_read[5m]))", "legendFormat": "Hit Ratio" }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Replication Lag",
      "gridPos": { "x": 18, "y": 23, "w": 6, "h": 8 },
      "options": {
        "legend": { "calcs": ["mean", "max", "last"], "displayMode": "table" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        }
      },
      "targets": [
        { "expr": "pg_replication_lag_bytes", "legendFormat": "Lag" }
      ],
      "description": "PostgreSQL replication lag in bytes"
    },
    {
      "id": 19,
      "type": "row",
      "title": "Redis",
      "gridPos": { "x": 0, "y": 31, "w": 24, "h": 1 },
