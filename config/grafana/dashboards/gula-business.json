{
  "id": null,
  "uid": "gula-business",
  "title": "GULA Platform — Business Metrics",
  "description": "Business KPIs for GULA Medical Lab Platform operations",
  "tags": ["gula", "business", "kpi"],
  "timezone": "Asia/Baghdad",
  "refresh": "5m",
  "schemaVersion": 38,
  "version": 1,
  "time": { "from": "now-7d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Daily Active Users (DAU)",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [{ "expr": "gula_dau", "legendFormat": "DAU" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Monthly Active Users (MAU)",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [{ "expr": "gula_mau", "legendFormat": "MAU" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total Labs Onboarded",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [{ "expr": "gula_total_labs", "legendFormat": "Labs" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Total Orders (All Time)",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [{ "expr": "gula_orders_total", "legendFormat": "Orders" }]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Total Results (All Time)",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [{ "expr": "gula_results_total", "legendFormat": "Results" }]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Subscription Distribution",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [{ "expr": "gula_subscription_count", "legendFormat": "{{ tier }}" }]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Orders by Lab (Top 10)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 10 },
      "options": {
        "legend": { "calcs": ["mean", "max", "last"], "displayMode": "table" }
      },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [{ "expr": "topk(10, sum by(lab_id) (increase(gula_orders_total[24h])))", "legendFormat": "Lab {{ lab_id }}" }]
    },
    {
      "id": 8,
      "type": "piechart",
      "title": "Orders by Test Type",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 10 },
      "options": {
        "pieType": "pie",
        "displayLabels": ["name", "percent"],
        "legend": { "displayMode": "table", "placement": "right" }
      },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [{ "expr": "sum by(test_type) (increase(gula_orders_total[7d]))", "legendFormat": "{{ test_type }}" }]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Result Turnaround Time (p50/p95/p99)",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "minutes",
          "min": 0
        }
      },
      "targets": [
        { "expr": "gula_turnaround_time_p50", "legendFormat": "p50" },
        { "expr": "gula_turnaround_time_p95", "legendFormat": "p95" },
        { "expr": "gula_turnaround_time_p99", "legendFormat": "p99" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Critical Result Rate",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 }
      },
      "targets": [{ "expr": "increase(gula_critical_results_total[1h]) / increase(gula_results_total[1h])", "legendFormat": "Critical Rate" }]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Patient Registrations (Daily)",
      "gridPos": { "x": 0, "y": 22, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [{ "expr": "increase(gula_patient_registrations_total[24h])", "legendFormat": "Registrations" }]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Lab Onboarding Progress",
      "gridPos": { "x": 12, "y": 22, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [{ "expr": "gula_lab_onboarding_stage", "legendFormat": "Lab {{ lab_id }} Stage {{ stage }}" }]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Subscription Tier Distribution",
      "gridPos": { "x": 0, "y": 30, "w": 12, "h": 8 },
      "options": {
        "legend": { "calcs": ["mean", "max", "last"], "displayMode": "table" }
      },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [{ "expr": "gula_subscription_count", "legendFormat": "{{ tier }}" }]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Revenue (Monthly)",
      "gridPos": { "x": 12, "y": 30, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "USD" }
      },
      "targets": [{ "expr": "increase(gula_revenue_total[30d])", "legendFormat": "Revenue" }]
    }
  ]
}
