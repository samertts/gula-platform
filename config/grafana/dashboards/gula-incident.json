{
  "id": null,
  "uid": "gula-incident",
  "title": "GULA Platform — Incident Management",
  "description": "Incident intelligence and management dashboard",
  "tags": ["gula", "incident"],
  "timezone": "Asia/Baghdad",
  "refresh": "15s",
  "schemaVersion": 38,
  "version": 1,
  "time": { "from": "now-24h", "to": "now" },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Incident Overview",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active Incidents — Critical",
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        { "expr": "gula_active_incidents{severity=\"critical\"}", "legendFormat": "Critical" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active Incidents — Major",
      "gridPos": { "x": 4, "y": 1, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "orange", "value": 5 },
              { "color": "red", "value": 10 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        { "expr": "gula_active_incidents{severity=\"major\"}", "legendFormat": "Major" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Active Incidents — Minor",
      "gridPos": { "x": 8, "y": 1, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "orange", "value": 15 },
              { "color": "red", "value": 30 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        { "expr": "gula_active_incidents{severity=\"minor\"}", "legendFormat": "Minor" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Mean Time to Resolve (MTTR)",
      "gridPos": { "x": 12, "y": 1, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "minutes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "orange", "value": 60 },
              { "color": "red", "value": 120 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        { "expr": "gula_mttr_minutes", "legendFormat": "MTTR" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Incident Response Time",
      "gridPos": { "x": 16, "y": 1, "w": 8, "h": 4 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "calcs": ["mean", "max", "last"], "displayMode": "table" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "seconds",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 300 },
              { "color": "orange", "value": 600 },
              { "color": "red", "value": 900 }
            ]
          },
          "custom": { "lineWidth": 2 },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        { "expr": "gula_incident_response_time_seconds", "legendFormat": "Response Time" }
      ]
    },
    {
      "id": 7,
      "type": "piechart",
      "title": "Incidents by Category",
      "gridPos": { "x": 0, "y": 5, "w": 8, "h": 8 },
      "options": {
        "pieType": "pie",
        "displayLabels": ["name", "percent", "value"],
        "legend": { "displayMode": "table", "placement": "right" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        { "expr": "increase(gula_incidents_by_category_total[7d])", "legendFormat": "{{ category }}" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Incident Trend (24h)",
      "gridPos": { "x": 8, "y": 5, "w": 8, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "calcs": ["mean", "max", "last"], "displayMode": "table", "placement": "right" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 15 },
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        { "expr": "increase(gula_incidents_total[1h])", "legendFormat": "New Incidents" }
      ]
    },
    {
      "id": 9,
      "type": "gauge",
      "title": "SLA Compliance Rate",
      "gridPos": { "x": 16, "y": 5, "w": 8, "h": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 90 },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        { "expr": "gula_sla_compliance_percent", "legendFormat": "SLA %" }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Top Affected Services",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "options": {
        "sortBy": [
          { "displayName": "Incidents", "desc": true }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3 },
              { "color": "orange", "value": 10 },
              { "color": "red", "value": 20 }
            ]
          },
          "unit": "short",
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "topk(10, sum by(service) (increase(gula_incidents_by_service_total[7d])))",
          "format": "table",
          "legendFormat": "{{ service }}"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": {
              "service": "Service",
              "Value": "Incidents (7d)"
            }
          }
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Escalation Rate",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "calcs": ["mean", "max", "last"], "displayMode": "table" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3 },
              { "color": "orange", "value": 8 },
              { "color": "red", "value": 15 }
            ]
          },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        { "expr": "increase(gula_incident_escalations_total[1h])", "legendFormat": "Escalations" }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Incidents by Severity Over Time",
      "gridPos": { "x": 0, "y": 21, "w": 12, "h": 7 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "calcs": ["mean", "max", "last"], "displayMode": "table", "placement": "right" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        { "expr": "increase(gula_incidents_total{severity=\"critical\"}[6h])", "legendFormat": "Critical" },
        { "expr": "increase(gula_incidents_total{severity=\"major\"}[6h])", "legendFormat": "Major" },
        { "expr": "increase(gula_incidents_total{severity=\"minor\"}[6h])", "legendFormat": "Minor" }
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Total Incidents (24h)",
      "gridPos": { "x": 12, "y": 21, "w": 3, "h": 3 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "orange", "value": 25 },
              { "color": "red", "value": 50 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        { "expr": "increase(gula_incidents_total[24h])", "legendFormat": "Total" }
      ]
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Open Incidents",
      "gridPos": { "x": 15, "y": 21, "w": 3, "h": 3 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "orange", "value": 15 },
              { "color": "red", "value": 30 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        { "expr": "gula_open_incidents", "legendFormat": "Open" }
      ]
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Resolved Today",
      "gridPos": { "x": 18, "y": 21, "w": 3, "h": 3 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        { "expr": "increase(gula_incidents_resolved_total[24h])", "legendFormat": "Resolved" }
      ]
    },
    {
      "id": 16,
      "type": "stat",
      "title": "Acknowledged SLA Breaches",
      "gridPos": { "x": 21, "y": 21, "w": 3, "h": 3 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        { "expr": "gula_sla_breaches_total", "legendFormat": "Breaches" }
      ]
    }
  ],
  "templating": { "list": [] },
  "links": [],
  "timepicker": {}
}
