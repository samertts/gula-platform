{
  "id": null,
  "uid": "gula-security",
  "title": "GULA Platform — Security Operations",
  "description": "Security monitoring dashboard for GULA Medical Lab Platform",
  "tags": ["gula", "security", "monitoring"],
  "timezone": "Asia/Baghdad",
  "refresh": "15s",
  "schemaVersion": 38,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Authentication & Access",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Failed Authentication Attempts",
      "gridPos": { "x": 0, "y": 1, "w": 8, "h": 8 },
      "options": {
        "legend": { "calcs": ["mean", "max", "last"], "displayMode": "table" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      },
      "targets": [{ "expr": "increase(gula_auth_failures_total[5m])", "legendFormat": "Auth Failures" }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Rate Limit Blocks",
      "gridPos": { "x": 8, "y": 1, "w": 8, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 20 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      },
      "targets": [{ "expr": "increase(gula_rate_limit_blocks_total[15m])", "legendFormat": "Blocks" }]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Intrusion Detection Events",
      "gridPos": { "x": 16, "y": 1, "w": 8, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [{ "expr": "increase(gula_intrusion_detection_total[5m])", "legendFormat": "Events" }]
    },
    {
      "id": 5,
      "type": "row",
      "title": "API Security",
      "gridPos": { "x": 0, "y": 9, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 6,
      "type": "table",
      "title": "API Error Rate by Endpoint",
      "gridPos": { "x": 0, "y": 10, "w": 12, "h": 8 },
      "options": {
        "sortBy": [{ "displayName": "Error Rate", "desc": true }]
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "targets": [
        {
          "expr": "sum(rate(gula_request_errors_total[5m])) by (endpoint) / sum(rate(gula_requests_total[5m])) by (endpoint)",
          "format": "table",
          "legendFormat": "{{ endpoint }}"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "endpoint": "Endpoint", "Value": "Error Rate" } } }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "JWT Validation Failures",
      "gridPos": { "x": 12, "y": 10, "w": 6, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 10 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      },
      "targets": [{ "expr": "increase(gula_jwt_validation_failures_total[15m])", "legendFormat": "JWT Failures" }]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Permission Denied Events",
      "gridPos": { "x": 18, "y": 10, "w": 6, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 10 },
              { "color": "red", "value": 30 }
            ]
          }
        }
      },
      "targets": [{ "expr": "increase(gula_permission_denied_total[15m])", "legendFormat": "Denied" }]
    },
    {
      "id": 9,
      "type": "row",
      "title": "Audit & Policy",
      "gridPos": { "x": 0, "y": 18, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Audit Log Volume",
      "gridPos": { "x": 0, "y": 19, "w": 8, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [{ "expr": "increase(gula_audit_log_total[1h])", "legendFormat": "Audit Events" }]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Policy Engine Blocks",
      "gridPos": { "x": 8, "y": 19, "w": 8, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      },
      "targets": [{ "expr": "increase(gula_policy_block_total[5m])", "legendFormat": "Blocks" }]
    },
    {
      "id": 12,
      "type": "table",
      "title": "Top Blocked IPs",
      "gridPos": { "x": 16, "y": 19, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "topk(10, sum by(source_ip) (increase(gula_rate_limit_blocks_total[24h])))",
          "format": "table",
          "legendFormat": "{{ source_ip }}"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "source_ip": "Source IP", "Value": "Blocks (24h)" } } }
      ]
    },
    {
      "id": 13,
      "type": "row",
      "title": "Security Status Summary",
      "gridPos": { "x": 0, "y": 27, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Auth Failure Rate",
      "gridPos": { "x": 0, "y": 28, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "red", "value": 200 }
            ]
          }
        }
      },
      "targets": [{ "expr": "increase(gula_auth_failures_total[1h])", "legendFormat": "Failures" }]
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Active Rate Limit Blocks",
      "gridPos": { "x": 4, "y": 28, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [{ "expr": "gula_active_rate_limit_blocks", "legendFormat": "Blocked" }]
    },
    {
      "id": 16,
      "type": "stat",
      "title": "Kill Switch",
      "gridPos": { "x": 8, "y": 28, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "INACTIVE", "color": "green" } } },
            { "type": "value", "options": { "1": { "text": "ACTIVE", "color": "red" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [{ "expr": "gula_kill_switch_active", "legendFormat": "Kill Switch" }]
    }
  ]
}
