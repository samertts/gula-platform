  "product_name": "RabbitMQ",
  "vhosts": [
    {"name": "gula"}
  ],
  "users": [
    {
      "name": "gula",
      "password_hash": "UGFzc3dvcmQ6Z3VsYV9yYWJiaXRfMjAyNA==",
