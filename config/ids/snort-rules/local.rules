# =============================================================================
# Snort IDS Rules — GULA Platform API Protection
# =============================================================================
# Path: /etc/snort/rules/local.rules
# Managed by: Security Operations
# Ruleset version: 1.0.0
# Last updated: 2026-07-15
# =============================================================================
#
# Rule Header Format:
#   alert <protocol> <src_ip> <src_port> -> <dst_ip> <dst_port>
#   (msg:"<description>";
#    content/uricontent/pcre patterns;
#    sid:<unique_id>;
#    classtype:<classification>;
#    priority:<1-4>;)
#
# SID Range Allocation:
#   1000000-1000999: SQL Injection
#   1001000-1001999: XSS
#   1002000-1002999: Path Traversal
#   1003000-1003999: Command Injection
#   1004000-1004999: SSRF
#   1005000-1005999: API Abuse
#   1006000-1006999: Scanner / Probe Detection
#   1007000-1007999: Authentication Attacks
#   1008000-1008999: Data Exfiltration / Leakage
#   1009000-1009999: General / Catch-all
#

# ============================================================================
# PREAMBLE — Local rules configuration
# ============================================================================
# Include local rules after all distributed rules
# ipvar GULA_API_NET 10.0.0.0/8
# ipvar GULA_INTERNAL_NET 10.0.0.0/8
# ipvar EXTERNAL_NET !$GULA_INTERNAL_NET
# portvar HTTP_PORTS [80,443,8080,8000]

# ============================================================================
# SECTION 1: SQL INJECTION (SID: 1000000-1000999)
# ============================================================================
# Detect classic SQL injection patterns in URI and request body

# 1.1 — Basic tautology: ' OR 1=1, ' OR '1'='1, etc.
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-SQLI Basic tautology 'OR 1=1' detected";
   flow:to_server,established;
   content:"' OR"; nocase; http_uri;
   content:"1=1"; distance:0; within:10; http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1000001; priority:1; rev:1;)

alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-SQLI Tautology 'OR 1=1' in request body";
   flow:to_server,established;
   content:"' OR"; nocase; http_client_body;
   content:"1=1"; distance:0; within:10; http_client_body;
   classtype:attempted-repository-vulnerability;
   sid:1000002; priority:1; rev:1;)

alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-SQLI 'OR' tautology variant";
   flow:to_server,established;
   pcre:"/(\bOR\b|\bAND\b)\s+[\"']?[^\s]+\s*=\s*[\"']?[^\s]+/i";
   classtype:attempted-repository-vulnerability;
   sid:1000003; priority:2; rev:2;)

# 1.2 — UNION SELECT detection
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-SQLI UNION SELECT in URI";
   flow:to_server,established;
   content:"UNION"; nocase; http_uri;
   content:"SELECT"; nocase; distance:0; within:10; http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1000010; priority:1; rev:1;)

alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-SQLI UNION SELECT in request body";
   flow:to_server,established;
   content:"UNION"; nocase; http_client_body;
   content:"SELECT"; nocase; distance:0; within:10; http_client_body;
   classtype:attempted-repository-vulnerability;
   sid:1000011; priority:1; rev:1;)

alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-SQLI UNION ALL SELECT in URI";
   flow:to_server,established;
   content:"UNION"; nocase; http_uri;
   content:"ALL"; nocase; distance:0; within:6; http_uri;
   content:"SELECT"; nocase; distance:0; within:10; http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1000012; priority:1; rev:1;)

# 1.3 — DROP TABLE / DROP DATABASE detection
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-SQLI DROP TABLE in URI";
   flow:to_server,established;
   content:"DROP"; nocase; http_uri;
   content:"TABLE"; nocase; distance:0; within:10; http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1000020; priority:1; rev:1;)

alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-SQLI DROP TABLE in request body";
   flow:to_server,established;
   content:"DROP"; nocase; http_client_body;
   content:"TABLE"; nocase; distance:0; within:10; http_client_body;
   classtype:attempted-repository-vulnerability;
   sid:1000021; priority:1; rev:1;)

alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-SQLI DROP DATABASE in URI";
   flow:to_server,established;
   content:"DROP"; nocase; http_uri;
   content:"DATABASE"; nocase; distance:0; within:10; http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1000022; priority:1; rev:1;)

alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-SQLI DROP in request body";
   flow:to_server,established;
   pcre:"/\bDROP\s+(TABLE|DATABASE|SCHEMA|INDEX|VIEW|PROCEDURE|FUNCTION)\b/i";
   classtype:attempted-repository-vulnerability;
   sid:1000023; priority:1; rev:2;)

# 1.4 — DELETE / INSERT / UPDATE / ALTER detection
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-SQLI DELETE FROM in URI";
   flow:to_server,established;
   content:"DELETE"; nocase; http_uri;
   content:"FROM"; nocase; distance:0; within:10; http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1000030; priority:1; rev:1;)

alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-SQLI INSERT INTO in URI";
   flow:to_server,established;
   content:"INSERT"; nocase; http_uri;
   content:"INTO"; nocase; distance:0; within:10; http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1000031; priority:1; rev:1;)

alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-SQLI ALTER TABLE in URI";
   flow:to_server,established;
   content:"ALTER"; nocase; http_uri;
   content:"TABLE"; nocase; distance:0; within:10; http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1000032; priority:1; rev:1;)

# 1.5 — Comments and inline SQL
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-SQLI SQL comment injection -- in URI";
   flow:to_server,established;
   content:"--"; http_uri;
   content:"--"; distance:0; within:2; http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1000040; priority:2; rev:1;)

alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-SQLI block comment injection /* in URI";
   flow:to_server,established;
   content:"/*"; http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1000041; priority:2; rev:1;)

# 1.6 — pg_sleep / BENCHMARK timing detection
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-SQLI pg_sleep timing attack in URI";
   flow:to_server,established;
   content:"pg_sleep"; nocase; http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1000050; priority:1; rev:1;)

alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-SQLI BENCHMARK timing attack in URI";
   flow:to_server,established;
   content:"BENCHMARK"; nocase; http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1000051; priority:1; rev:1;)

# 1.7 — INFORMATION_SCHEMA queries
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-SQLI INFORMATION_SCHEMA query in URI";
   flow:to_server,established;
   content:"INFORMATION_SCHEMA"; nocase; http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1000060; priority:2; rev:1;)

alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-SQLI INFORMATION_SCHEMA query in request body";
   flow:to_server,established;
   content:"INFORMATION_SCHEMA"; nocase; http_client_body;
   classtype:attempted-repository-vulnerability;
   sid:1000061; priority:2; rev:1;)

# 1.8 — EXEC / EXECUTE immediate
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-SQLI EXECUTE IMMEDIATE in URI";
   flow:to_server,established;
   content:"EXECUTE"; nocase; http_uri;
   content:"IMMEDIATE"; nocase; distance:0; within:15; http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1000070; priority:1; rev:1;)

# 1.9 — xp_cmdshell (MSSQL specific, but check anyway)
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-SQLI xp_cmdshell in URI";
   flow:to_server,established;
   content:"xp_cmdshell"; nocase; http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1000080; priority:1; rev:1;)

# 1.10 — General SQL injection pcre catch-all
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-SQLI General SQL keyword sequence in URI";
   flow:to_server,established;
   pcre:"/(\bSELECT\b.*\bFROM\b|\bINSERT\b.*\bINTO\b|\bUPDATE\b.*\bSET\b|\bDELETE\b.*\bFROM\b|\bCREATE\b.*\bTABLE\b|\bALTER\b.*\bTABLE\b|\bTRUNCATE\b)/i";
   classtype:attempted-repository-vulnerability;
   sid:1000090; priority:2; rev:2;)

alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-SQLI General SQL keyword in POST body";
   flow:to_server,established;
   pcre:"/(\bSELECT\b.*\bFROM\b|\bINSERT\b.*\bINTO\b|\bUPDATE\b.*\bSET\b|\bDELETE\b.*\bFROM\b|\bCREATE\b.*\bTABLE\b|\bALTER\b.*\bTABLE\b|\bTRUNCATE\b)/i";
   http_client_body;
   classtype:attempted-repository-vulnerability;
   sid:1000091; priority:2; rev:2;)

# ============================================================================
# SECTION 2: CROSS-SITE SCRIPTING (XSS) (SID: 1001000-1001999)
# ============================================================================

# 2.1 — <script> tag detection
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-XSS <script> tag in URI";
   flow:to_server,established;
   content:"<script"; nocase; http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1001000; priority:1; rev:1;)

alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-XSS <script> tag in request body";
   flow:to_server,established;
   content:"<script"; nocase; http_client_body;
   classtype:attempted-repository-vulnerability;
   sid:1001001; priority:1; rev:1;)

alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-XSS </script> tag in URI";
   flow:to_server,established;
   content:"</script>"; nocase; http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1001002; priority:1; rev:1;)

# 2.2 — onerror= / onload= / onmouseover= event handlers
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-XSS onerror event handler in URI";
   flow:to_server,established;
   content:"onerror"; nocase; http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1001010; priority:1; rev:1;)

alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-XSS onerror event handler in request body";
   flow:to_server,established;
   content:"onerror"; nocase; http_client_body;
   classtype:attempted-repository-vulnerability;
   sid:1001011; priority:1; rev:1;)

alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-XSS onload event handler in URI";
   flow:to_server,established;
   content:"onload"; nocase; http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1001012; priority:1; rev:1;)

alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-XSS Event handler in URI";
   flow:to_server,established;
   pcre:"/\son\w+\s*=\s*['\"]?/i";
   http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1001013; priority:2; rev:2;)

# 2.3 — javascript: scheme
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-XSS javascript: scheme in URI";
   flow:to_server,established;
   content:"javascript:"; nocase; http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1001020; priority:1; rev:1;)

alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-XSS javascript: scheme in request body";
   flow:to_server,established;
   content:"javascript:"; nocase; http_client_body;
   classtype:attempted-repository-vulnerability;
   sid:1001021; priority:1; rev:1;)

# 2.4 — document.cookie / document.write / window.location
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-XSS document.cookie access in URI";
   flow:to_server,established;
   pcre:"/document\s*\.\s*cookie/i";
   http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1001030; priority:1; rev:1;)

alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-XSS document.write in URI";
   flow:to_server,established;
   pcre:"/document\s*\.\s*write/i";
   http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1001031; priority:1; rev:1;)

# 2.5 — eval() / setTimeout / setInterval
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-XSS eval() in URI";
   flow:to_server,established;
   content:"eval("; nocase; http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1001040; priority:1; rev:1;)

alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-XSS setTimeout in URI";
   flow:to_server,established;
   content:"setTimeout"; nocase; http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1001041; priority:1; rev:1;)

# 2.6 — Data URI scheme (potential XSS vector)
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-XSS data: URI scheme in URI";
   flow:to_server,established;
   content:"data:"; nocase; http_uri;
   content:"text/html"; nocase; distance:0; within:40; http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1001050; priority:2; rev:1;)

alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-XSS data: URI scheme in request body";
   flow:to_server,established;
   content:"data:"; nocase; http_client_body;
   content:"text/html"; nocase; distance:0; within:40; http_client_body;
   classtype:attempted-repository-vulnerability;
   sid:1001051; priority:2; rev:1;)

# 2.7 — Base64 encoded XSS
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-XSS Base64-encoded content in URI";
   flow:to_server,established;
   pcre:"/[A-Za-z0-9+/]{40,}={0,2}/i";
   http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1001060; priority:3; rev:1;)

# 2.8 — <img>, <iframe>, <svg> with event handlers
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-XSS <img> tag with event handler in URI";
   flow:to_server,established;
   content:"<img"; nocase; http_uri;
   content:"onerror"; nocase; distance:0; within:200; http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1001070; priority:1; rev:1;)

alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-XSS <iframe> tag in URI";
   flow:to_server,established;
   content:"<iframe"; nocase; http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1001071; priority:1; rev:1;)

# 2.9 — alert(), prompt(), confirm() probes
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-XSS alert() probe in URI";
   flow:to_server,established;
   pcre:"/alert\s*\(/i";
   http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1001080; priority:2; rev:1;)

alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-XSS prompt() probe in URI";
   flow:to_server,established;
   pcre:"/prompt\s*\(/i";
   http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1001081; priority:2; rev:1;)

# 2.10 — General XSS polyglot detection
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-XSS General XSS polyglot patterns in URI";
   flow:to_server,established;
   pcre:"/[<>].*[\"'\(\)]/i";
   http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1001090; priority:2; rev:2;)

# ============================================================================
# SECTION 3: PATH TRAVERSAL (SID: 1002000-1002999)
# ============================================================================

# 3.1 — Directory traversal ../ in URI
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-PT Directory traversal ../ in URI";
   flow:to_server,established;
   content:"../"; http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1002000; priority:1; rev:1;)

alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-PT Directory traversal ..%2f in URI";
   flow:to_server,established;
   content:"..%2f"; nocase; http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1002001; priority:1; rev:1;)

alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-PT Directory traversal ..%5c in URI";
   flow:to_server,established;
   content:"..%5c"; nocase; http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1002002; priority:1; rev:1;)

# 3.2 — Encoded traversal variants
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-PT Double-encoded traversal %252e%252e%252f in URI";
   flow:to_server,established;
   content:"%252e%252e%252f"; nocase; http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1002010; priority:1; rev:1;)

alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-PT Unicode-encoded traversal %c0%ae%c0%ae/ in URI";
   flow:to_server,established;
   content:"%c0%ae%c0%ae"; nocase; http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1002011; priority:1; rev:1;)

alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-PT Unicode-encoded traversal %c0%ae%c0%ae%c0%af in URI";
   flow:to_server,established;
   content:"%c0%ae%c0%ae%c0%af"; nocase; http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1002012; priority:1; rev:1;)

# 3.3 — Access to sensitive system files via path traversal
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-PT Attempted access to /etc/passwd via traversal";
   flow:to_server,established;
   pcre:"/(\.\.\/|\%2e\%2e\%2f|\%2e\%2e\/).*etc\/passwd/i";
   http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1002020; priority:1; rev:1;)

alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-PT Attempted access to Windows system files";
   flow:to_server,established;
   pcre:"/(\.\.\/|\.\.\\\|\%2e\%2e\%2f|\%2e\%2e\%5c).*(win\.ini|boot\.ini|autoexec\.bat|system32|windows)/i";
   http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1002021; priority:1; rev:1;)

alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-PT Attempted access to .env file via traversal";
   flow:to_server,established;
   pcre:"/(\.\.\/|\%2e\%2e\%2f|\%2e\%2e\/).*\.env/i";
   http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1002022; priority:1; rev:1;)

alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-PT Attempted access to application config files";
   flow:to_server,established;
   pcre:"/(\.\.\/|\%2e\%2e\%2f).*(config\.py|config\.yml|config\.json|settings\.py|\.env\.\w+)/i";
   http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1002023; priority:1; rev:1;)

# 3.4 — Absolute path access attempts
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-PT Absolute path access to /etc/ in URI";
   flow:to_server,established;
   pcre:"/\/etc\/(passwd|shadow|hosts|hostname|resolv\.conf|issue|fstab|cron|sudoers|ldap|ssl|cert|ssh|nginx|mysql|postgres)/i";
   http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1002030; priority:1; rev:1;)

alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-PT Absolute path access to /proc/ in URI";
   flow:to_server,established;
   pcre:"/\/proc\/(self\/environ|self\/cmdline|self\/fd|\d+\/|cpuinfo|meminfo|mounts|net\/)/i";
   http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1002031; priority:1; rev:1;)

alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-PT Absolute path access to .git/ in URI";
   flow:to_server,established;
   pcre:"/\.git\/(config|HEAD|index|refs|objects|logs|hooks)/i";
   http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1002032; priority:1; rev:1;)

# 3.5 — Null byte injection with path traversal
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-PT Null byte injection with path traversal";
   flow:to_server,established;
   pcre:"/(\.\.\/|\%2e\%2e\%2f).*\%00/i";
   http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1002040; priority:1; rev:1;)

# ============================================================================
# SECTION 4: COMMAND INJECTION (SID: 1003000-1003999)
# ============================================================================

# 4.1 — Semicolon command chaining
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-CI Semicolon command chaining in URI";
   flow:to_server,established;
   pcre:"/[;|]\s*(ls|cat|id|whoami|pwd|uname|ifconfig|ip\s|netstat|ps\s|kill|chmod|chown|wget|curl|nc\s|bash|sh\s|python|perl|ruby|php|node|rm\s|mv\s|cp\s|mkfifo|mknod|echo\s|printf\s)\s/i";
   http_uri;
   classtype:attempted-repository-vulnerability;
   sid:1003000; priority:1; rev:2;)

