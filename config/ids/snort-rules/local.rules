   sid:1008020; priority:1; rev:1;)

# ============================================================================
# SECTION 10: GENERAL / CATCH-ALL (SID: 1009000-1009999)
# ============================================================================

# 10.1 — Missing security headers in response
alert tcp $HTTP_SERVERS $HTTP_PORTS -> $EXTERNAL_NET any
  (msg:"GULA-GEN Missing X-Content-Type-Options header";
   flow:from_server,established;
   content:!"X-Content-Type-Options"; http_header;
   classtype:policy-violation;
   sid:1009000; priority:3; rev:1;)

alert tcp $HTTP_SERVERS $HTTP_PORTS -> $EXTERNAL_NET any
  (msg:"GULA-GEN Missing X-Frame-Options header";
   flow:from_server,established;
   content:!"X-Frame-Options"; http_header;
   classtype:policy-violation;
   sid:1009001; priority:3; rev:1;)

# 10.2 — Invalid content-type detection
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-GEN Suspicious content-type in POST request";
   flow:to_server,established;
   content:"POST"; http_method;
   content:!"Content-Type"; http_header;
   classtype:attempted-recon;
   sid:1009010; priority:3; rev:1;)

# 10.3 — Catch-all for any unclassified suspicious URI encoding
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-GEN Excessive URI encoding detected";
   flow:to_server,established;
   pcre:"/(%[0-9a-fA-F]{2}){10,}/";
   http_uri;
   classtype:attempted-recon;
   sid:1009020; priority:3; rev:1;)

# 10.4 — Catch-all for non-HTTP traffic on HTTP ports (tunnel detection)
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-GEN Non-HTTP traffic on HTTP port (potential tunnel)";
   flow:to_server,established;
   content:!"GET"; http_method;
   content:!"POST"; http_method;
   content:!"PUT"; http_method;
   content:!"DELETE"; http_method;
   content:!"HEAD"; http_method;
   content:!"OPTIONS"; http_method;
   content:!"PATCH"; http_method;
   classtype:attempted-recon;
   sid:1009030; priority:2; rev:1;)

# 10.5 — Websocket abuse
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS
  (msg:"GULA-GEN Websocket upgrade abuse";
   flow:to_server,established;
   content:"Upgrade"; http_header;
   content:"websocket"; nocase; distance:0; within:20; http_header;
   threshold:type threshold, track by_src, count 100, seconds 60;
   classtype:attempted-dos;
   sid:1009040; priority:2; rev:1;)
