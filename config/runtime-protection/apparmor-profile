# =============================================================================
# AppArmor Profile — gula-backend container
# =============================================================================
# Path: /etc/apparmor.d/gula-backend
# Profile: gula-backend
# Managed by: Security Operations
# Applied to: docker run --security-opt apparmor=gula-backend
# Last updated: 2026-07-15
# =============================================================================
#
# This profile enforces mandatory access control for the gula-backend
# FastAPI application container. It follows the principle of least privilege:
# - Explicit ALLOW for required resources
# - Explicit DENY for sensitive operations
# - AUDIT for security-critical denied access attempts
#

#include <tunables/global>

profile gula-backend flags=(attach_disconnected,mediate_deleted) {

  # ============================================================================
  # IMPORTS — Common abstractions
  # ============================================================================
  #include <abstractions/base>
  #include <abstractions/python>
  #include <abstractions/nameservice>
  #include <abstractions/openssl>

  # ============================================================================
  # CAPABILITIES — Minimal set required for operation
  # ============================================================================
  # Explicit allow list — everything else is denied by default
  capability dac_override,        # Override DAC access checks (file permission checks)
  capability dac_read_search,     # Read/search bypass for DAC
  capability net_bind_service,    # Bind to network ports (port 8000)
  capability net_admin,           # Network administration (socket options)
  capability sys_resource,        # Resource limits (RLIMIT_NPROC, etc.)
  capability setgid,              # Set group identity
  capability setuid,              # Set user identity
  capability setpcap,             # Set process capabilities
  capability chown,               # Change file ownership
  capability fowner,              # Bypass ownership checks
  capability fsetid,              # Bypass ownership checks on setuid

  # Explicitly denied capabilities (safety net)
  deny capability sys_admin,          # System administration
  deny capability sys_boot,           # Reboot
  deny capability sys_chroot,         # chroot
  deny capability sys_module,         # Kernel module loading
  deny capability sys_nice,           # Priority changes
  deny capability sys_pacct,          # Process accounting
  deny capability sys_ptrace,         # Process tracing
  deny capability sys_rawio,          # Raw I/O
  deny capability sys_time,           # System clock
  deny capability sys_tty_config,     # TTY config
  deny capability syslog,             # Kernel syslog
  deny capability audit_control,      # Audit subsystem
  deny capability audit_write,        # Audit subsystem
  deny capability kill,               # Signal sending
  deny capability lease,              # File leases
  deny capability linux_immutable,    # FS_IMMUTABLE
  deny capability mac_admin,          # MAC administration
  deny capability mac_override,       # MAC override
  deny capability mknod,              # Device node creation
  deny capability net_raw,            # Raw sockets
  deny capability net_broadcast,      # Broadcast
  deny capability block_suspend,      # Suspend blocker
  deny capability wake_alarm,         # Wake alarm

  # ============================================================================
  # NETWORK ACCESS
  # ============================================================================
  network unix stream,
  network unix dgram,
  network unix seqpacket,

  network inet tcp,
  network inet udp,
  network inet6 tcp,
  network inet6 udp,

  # Allow binding to application port
  network inet tcp bind port 8000,
  network inet6 tcp bind port 8000,

  # Allow connecting to infrastructure services
  network inet tcp connect port 5432,   # PostgreSQL
  network inet tcp connect port 6379,   # Redis
  network inet tcp connect port 5672,   # RabbitMQ AMQP
  network inet tcp connect port 15672,  # RabbitMQ management
  network inet tcp connect port 443,    # HTTPS external
  network inet tcp connect port 80,     # HTTP external

  network inet6 tcp connect port 5432,
  network inet6 tcp connect port 6379,
  network inet6 tcp connect port 5672,
  network inet6 tcp connect port 15672,
  network inet6 tcp connect port 443,
  network inet6 tcp connect port 80,

  # Allow DNS resolution
  network inet dgram,
  network inet6 dgram,
  network netlink raw,

  # ============================================================================
  # FILE SYSTEM ACCESS
  # ============================================================================

  # --- Application code (read-only) ---
  /app/                              r,
  /app/**                            r,
  /app/**/*.py                       r,
  /app/**/*.yml                      r,
  /app/**/*.yaml                     r,
  /app/**/*.json                     r,
  /app/**/*.toml                     r,
  /app/**/*.cfg                      r,
  /app/**/*.conf                     r,
  /app/**/*.pem                      r,
  /app/**/*.crt                      r,
  /app/**/*.key                      r,

  # --- Application data (read-write) ---
  /app/data/                         rw,
  /app/data/**                       rw,
  /app/data/**/*.log                 rw,
  /app/data/**/*.db                  rw,
  /app/data/**/*.sqlite              rw,
  /app/data/**/*.pid                 rw,
  /app/data/**/*.sock                rw,

  # --- Temporary files (read-write) ---
  /tmp/                              rw,
  /tmp/**                            rw,
  /tmp/**/*.tmp                      rw,
  /tmp/**/*.pid                      rw,
  /tmp/**/*.sock                     rw,

  # --- Log files (read-write) ---
  /var/log/                          r,
  /var/log/**                        rw,
  /var/log/**/*.log                  rw,

  # --- Proc filesystem (read-only) ---
  /proc/                             r,
  /proc/**                           r,
  /proc/cpuinfo                      r,
  /proc/meminfo                      r,
  /proc/loadavg                      r,
  /proc/uptime                       r,
  /proc/stat                         r,
  /proc/self/                        r,
  /proc/self/**                      r,
  /proc/self/fd/                     rw,
  /proc/self/fd/**                   rw,
  /proc/*/status                     r,

  # --- System libraries (read-only) ---
  /lib/                              r,
  /lib/**                            r,
  /lib64/                            r,
  /lib64/**                          r,
  /usr/lib/                          r,
  /usr/lib/**                        r,
  /usr/lib64/                        r,
  /usr/lib64/**                      r,
  /usr/local/lib/                    r,
  /usr/local/lib/**                  r,

  # --- System configuration (read-only) ---
  /etc/                              r,
  /etc/**                            r,
  /etc/hostname                      r,
  /etc/hosts                         r,
  /etc/resolv.conf                   r,
  /etc/nsswitch.conf                 r,
  /etc/ssl/                          r,
  /etc/ssl/**                        r,
  /etc/ssl/certs/                    r,
  /etc/ssl/certs/**                  r,
  /etc/localtime                     r,
  /etc/timezone                      r,
  /etc/passwd                        r,
  /etc/group                         r,
  /etc/ld.so.cache                   r,
  /etc/ld.so.conf                    r,
  /etc/ld.so.conf.d/                 r,
  /etc/ld.so.conf.d/**               r,

  # --- Device files (specific) ---
  /dev/null                         rw,
  /dev/zero                         rw,
  /dev/random                       r,
  /dev/urandom                      r,
  /dev/fd/                          rw,
  /dev/fd/**                        rw,
  /dev/stdin                        rw,
  /dev/stdout                       rw,
  /dev/stderr                       rw,
  /dev/pts/                         rw,
  /dev/pts/**                       rw,

  # ============================================================================
  # EXPLICIT DENIES
  # ============================================================================

  # --- System operations ---
  deny ptrace,
  deny mount,
  deny umount,
  deny umount2,
  deny pivot_root,
  deny io_uring,
  deny io_uring_setup,
  deny io_uring_enter,
  deny io_uring_register,
  deny swapon,
  deny swapoff,

  # --- Root filesystem write ---
  deny /                                rw,
  deny /*                               w,

  # --- Python bytecode cache (prevent poisoning) ---
  deny /**/*.pyc                         w,
  deny /**/__pycache__/                  w,
  deny /**/__pycache__/**                w,

  # --- Security-sensitive files ---
  deny /etc/shadow                       rw,
  deny /etc/gshadow                      rw,
  deny /etc/security/                    rw,
  deny /etc/security/**                  rw,
  deny /etc/sudoers                      rw,
  deny /etc/sudoers.d/                   rw,
  deny /etc/sudoers.d/**                 rw,
  deny /etc/ssh/                         rw,
  deny /etc/ssh/**                       rw,
  deny /root/                            rw,
  deny /root/**                          rw,
  deny /home/                            rw,
  deny /home/**                          rw,

  # --- Kernel interfaces ---
  deny /sys/                             rw,
  deny /sys/**                           rw,
  deny /proc/kcore                       rw,
  deny /proc/kallsyms                    rw,
  deny /proc/kmem                        rw,
  deny /proc/mem                         rw,
  deny /proc/sched_debug                 rw,
  deny /proc/slabinfo                    rw,
  deny /proc/zoneinfo                    rw,
  deny /proc/pagetypeinfo                rw,
  deny /proc/buddyinfo                   rw,

  # --- Audit denied access to shadow file (high severity signal) ---
  audit deny /etc/shadow                 rw,
  audit deny /etc/gshadow                rw,
  audit deny /etc/ssh/ssh_host_rsa_key   rw,
  audit deny /etc/ssh/ssh_host_ed25519_key rw,

  # ============================================================================
  # SIGNAL ACCESS
  # ============================================================================
  signal receive set=(
    hup int quit term usr1 usr2
  ),
  signal send set=(
    hup int quit term
  ) peer=gula-backend,

  # ============================================================================
  # PTRACE SCOPE
  # ============================================================================
  ptrace (read, trace) peer=gula-backend,
  deny ptrace (trace) peer=unconfined,

  # ============================================================================
  # CHANGE_PROFILE
  # ============================================================================
  deny change_profile,

  # ============================================================================
  # RLIMITS
  # ============================================================================
  set rlimit nproc <= unlimited,
  set rlimit nofile <= 65536,
  set rlimit memlock <= unlimited,
  set rlimit as <= unlimited,
  set rlimit cpu <= unlimited,
  set rlimit fsize <= unlimited,
  set rlimit data <= unlimited,
  set rlimit stack <= 8388608,
  set rlimit core <= 0,
  set rlimit rss <= unlimited,
  set rlimit msgqueue <= 819200,
}
