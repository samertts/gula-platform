{
  "_comment": "GULA Platform — MinIO HA Configuration (Distributed Mode, Erasure Coding)",
  "version": "2026.04.15",
  "cluster": {
    "name": "gula-object-store",
    "region": "me-central",
    "distributed": true,
    "nodes": 4,
    "drives_per_node": 1,
    "erasure_code_parity": 2,
    "erasure_code_stripe": 8,
    "min_drives_online": 3,
    "notes": "Erasure coding: 4 drives, parity=2 → tolerate 2 drive failures. Effective capacity: 50% of raw storage (4 drives, 2 parity). For 4TB system: 2TB usable."
  },
  "identity": {
    "mode": "openid",
    "provider_url": "https://auth.gula.health",
    "client_id": "minio-console",
    "claim_name": "policy",
    "claim_userinfo": true,
    "enable_audit_logs": true
  },
  "credentials": {
    "access_key": "${MINIO_ACCESS_KEY}",
    "secret_key": "${MINIO_SECRET_KEY}",
    "rotation_period_days": 90,
    "kms": {
      "enabled": true,
      "provider": "aws-kms",
      "endpoint": "https://kms.me-central-1.amazonaws.com",
      "region": "me-central-1",
      "key_id": "${MINIO_KMS_KEY_ID}"
    }
  },
  "buckets": [
    {
      "name": "gula-reports",
      "versioning": true,
      "locking": false,
      "quota": {
        "type": "hard",
        "size": "500GB"
      },
      "lifecycle": {
        "expiration_days": 90,
        "noncurrent_expiration_days": 7,
        "abort_incomplete_uploads_days": 1
      },
      "tags": {
        "purpose": "patient_reports",
        "retention": "90d",
        "classification": "confidential"
      }
    },
    {
      "name": "gula-results",
      "versioning": true,
      "locking": false,
      "quota": {
        "type": "hard",
        "size": "1TB"
      },
      "lifecycle": {
        "expiration_days": 365,
        "noncurrent_expiration_days": 30,
        "abort_incomplete_uploads_days": 1
      },
      "tags": {
        "purpose": "lab_results_export",
        "retention": "365d",
        "classification": "confidential"
      }
    },
    {
      "name": "gula-db-backups",
      "versioning": true,
      "locking": false,
      "quota": {
        "type": "hard",
        "size": "2TB"
      },
      "lifecycle": {
        "expiration_days": 60,
        "noncurrent_expiration_days": 7
      },
      "tags": {
        "purpose": "database_backups",
        "retention": "60d",
        "classification": "restricted"
      }
    },
    {
      "name": "gula-static",
      "versioning": false,
      "locking": false,
      "quota": {
        "type": "hard",
        "size": "100GB"
      },
      "lifecycle": {},
      "tags": {
        "purpose": "static_assets",
        "classification": "public"
      }
    }
  ],
  "replication": {
    "max_workers": 10,
    "health_check_interval": "30s",
    "bandwidth_limit": "1Gbps"
  },
  "encryption": {
    "at_rest": {
      "enabled": true,
      "provider": "kms",
      "algorithm": "AES-256-GCM"
    },
    "in_transit": {
      "enabled": true,
      "min_version": "TLSv1.2"
    }
  },
  "audit": {
    "webhook": {
      "enabled": true,
      "endpoint": "https://audit.gula.health/minio-events",
      "auth_token": "${MINIO_AUDIT_TOKEN}",
      "retry_interval": "10s",
      "max_retries": 5
    },
    "log_events": [
      "PutObject",
      "DeleteObject",
      "GetObject",
      "CreateBucket",
      "DeleteBucket",
      "PutBucketPolicy",
      "PutBucketLifecycle"
    ]
  },
  "monitoring": {
    "prometheus": {
      "enabled": true,
      "path": "/minio/v2/metrics/cluster",
      "auth_token": "${MINIO_METRICS_TOKEN}"
    },
    "console": {
      "enabled": true,
      "port": 9001,
      "tls": true
    }
  },
  "notifications": {
    "webhook": {
      "enabled": true,
      "endpoint": "https://events.gula.health/minio-events",
      "auth_token": "${MINIO_EVENTS_TOKEN}",
      "queue_limit": 10000,
      "events": [
        "s3:ObjectCreated:*",
        "s3:ObjectRemoved:*",
        "s3:ObjectRestore:*",
        "s3:ReducedRedundancyLostObject:*",
        "s3:Replication:*"
      ],
      "filter": {
        "prefix": "",
        "suffix": ""
      }
    }
  },
  "browser": {
    "enabled": false,
    "redirect_url": "https://console.gula.health"
  },
  "cache": {
    "enabled": true,
    "expiry": 90,
    "max_use": 10,
    "exclude": ["*.pdf", "*.zip"]
  },
  "storage_class": {
    "standard": {
      "parity": 2,
      "replicas": 1
    },
    "reduced_redundancy": {
      "parity": 1,
      "replicas": 1
    }
  }
}
