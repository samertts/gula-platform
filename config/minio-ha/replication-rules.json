{
  "_comment": "GULA Platform — MinIO Cross-Region Replication Rules",
  "version": "2026.04.15",
  "source": {
    "cluster": "gula-minio-me-central",
    "region": "me-central",
    "endpoint": "https://s3.me-central.gula.health"
  },
  "target": {
    "cluster": "gula-minio-eu-west1",
    "region": "eu-west1",
    "endpoint": "https://s3.eu-west1.gula.health"
  },
  "replication_rules": [
    {
      "rule_id": "replicate-all-objects",
      "priority": 1,
      "status": "Enabled",
      "delete_marker_replication": true,
      "delete_replication": false,
      "metadata_sync": true,
      "source_bucket": "gula-reports",
      "target_bucket": "gula-reports",
      "target_storage_class": "STANDARD",
      "tags": [],
      "sync_mode": "async",
      "bandwidth_limit": "500Mbps",
      "replication_time": {
        "enabled": true,
        "minutes": 15,
        "threshold": "15m"
      },
      "filter": {
        "prefix": "",
        "tags": []
      },
      "notes": "Patient reports replicated to EU-west for DR. RPO: 15 minutes."
    },
    {
      "rule_id": "replicate-clinical-results",
      "priority": 2,
      "status": "Enabled",
      "delete_marker_replication": true,
      "delete_replication": false,
      "metadata_sync": true,
      "source_bucket": "gula-results",
      "target_bucket": "gula-results",
      "target_storage_class": "STANDARD",
      "tags": [],
      "sync_mode": "async",
      "bandwidth_limit": "1Gbps",
      "replication_time": {
        "enabled": true,
        "minutes": 15,
        "threshold": "15m"
      },
      "filter": {
        "prefix": "",
        "tags": []
      },
      "notes": "Lab results are clinical data — RPO must be <15 minutes. Highest priority."
    },
    {
      "rule_id": "replicate-backups",
      "priority": 3,
      "status": "Enabled",
      "delete_marker_replication": true,
      "delete_replication": true,
      "metadata_sync": true,
      "source_bucket": "gula-db-backups",
      "target_bucket": "gula-db-backups",
      "target_storage_class": "STANDARD",
      "tags": [],
      "sync_mode": "async",
      "bandwidth_limit": "200Mbps",
      "replication_time": {
        "enabled": true,
        "minutes": 60,
        "threshold": "60m"
      },
      "filter": {
        "prefix": "",
        "tags": []
      },
      "notes": "DB backups — less urgent, can tolerate 1h RPO. Lower bandwidth to avoid saturating link."
    }
  ],
  "metrics": {
    "replication_lag_threshold_seconds": 900,
    "failed_replication_alert_threshold": 10,
    "check_interval_seconds": 30,
    "webhook": {
      "enabled": true,
      "endpoint": "https://alerts.gula.health/minio-replication",
      "auth_token": "${MINIO_REPLICATION_ALERT_TOKEN}"
    }
  },
  "notes": [
    "All rules are async (eventual consistency across regions).",
    "Delete marker replication is ON so a delete in me-central is mirrored to eu-west1.",
    "Actual delete replication is OFF — prevents accidental mass-delete propagation.",
    "Metadata sync ensures that object tags and metadata are consistent across regions.",
    "Replication time threshold alerts if objects take >15min to replicate (clinical priority).",
    "For DR compliance, run a periodic reconciliation: minio-replicate list-unreplicated"
  ]
}
