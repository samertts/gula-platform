{{- define "pagerduty.severity" -}}
{{- if eq .GroupLabels.severity "critical" -}}critical
{{- else if eq .GroupLabels.severity "warning" -}}warning
{{- else -}}info
{{- end -}}
{{- end -}}

{{- define "pagerduty.details" -}}
{
  "cluster": "gula-platform",
  "environment": "production",
  "service": "{{ .GroupLabels.service }}",
  "alert_name": "{{ .GroupLabels.alertname }}",
  "severity": "{{ .GroupLabels.severity }}",
  "region": "me-central-1",
  "platform": "gula",
  "firing_alerts": {{ .Alerts.Firing | len }},
  "resolved_alerts": {{ .Alerts.Resolved | len }},
  "dedup_key": "{{ .GroupLabels.alertname }}-{{ .GroupLabels.service }}"
}
{{- end }}

{{- define "pagerduty.dedup_key" -}}
{{ .GroupLabels.alertname }}-{{ .GroupLabels.service }}-{{ .GroupLabels.severity }}
{{- end }}
