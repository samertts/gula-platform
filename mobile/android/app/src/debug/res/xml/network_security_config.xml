<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Local emulator/development only; this file is not packaged in release. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>

    <!-- Debug may call staging, but it remains HTTPS-only. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">staging.gulaplatform.com</domain>
        <domain includeSubdomains="true">staging-api.gulaplatform.com</domain>
        <domain includeSubdomains="true">api.gula-platform.org</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
