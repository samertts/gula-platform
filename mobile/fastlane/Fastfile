default_platform(:android)

platform :android do
  desc "Run all Android tests"
  lane :test do
    gradle(task: "clean")
    gradle(task: "testDebugUnitTest")
    gradle(task: "ktlintCheck")
    gradle(task: "detekt")
  end

  desc "Build Android AAB and APK"
  lane :build_android do |options|
    gradle(task: "clean")
    build_type = options[:build_type] || "release"

    gradle(
      task: "bundle#{build_type.capitalize}",
      build_type: build_type,
      print_command: true,
      properties: {
        "android.injected.signing.store.file" => ENV["KEYSTORE_PATH"],
        "android.injected.signing.store.password" => ENV["KEYSTORE_PASSWORD"],
        "android.injected.signing.key.alias" => ENV["KEY_ALIAS"],
        "android.injected.signing.key.password" => ENV["KEY_PASSWORD"]
      }
    )

    gradle(
      task: "assemble#{build_type.capitalize}",
      build_type: build_type,
      print_command: true,
      properties: {
        "android.injected.signing.store.file" => ENV["KEYSTORE_PATH"],
        "android.injected.signing.store.password" => ENV["KEYSTORE_PASSWORD"],
        "android.injected.signing.key.alias" => ENV["KEY_ALIAS"],
        "android.injected.signing.key.password" => ENV["KEY_PASSWORD"]
      }
    )
  end

  desc "Deploy to Google Play Console"
  lane :deploy_android_play do |options|
    track = options[:track] || "alpha"
    metadata_path = options[:metadata_path] || "../fastlane/metadata/android"

    # Validate environment
    UI.user_error!("Missing PLAY_SERVICE_ACCOUNT_KEY") unless ENV["PLAY_SERVICE_ACCOUNT_KEY"]
    UI.user_error!("Missing KEYSTORE_PATH") unless ENV["KEYSTORE_PATH"]
    UI.user_error!("Missing KEYSTORE_PASSWORD") unless ENV["KEYSTORE_PASSWORD"]

    # Build if not already built
    build_android(build_type: "release") unless options[:skip_build]

    # Upload to Google Play
    supply(
      json_key_data: ENV["PLAY_SERVICE_ACCOUNT_KEY"],
      package_name: "io.gula.android",
      track: track,
      release_status: "completed",
      skip_upload_metadata: options[:skip_metadata] || false,
      skip_upload_images: options[:skip_images] || false,
      skip_upload_screenshots: options[:skip_screenshots] || false,
      metadata_path: metadata_path,
      version_code: options[:version_code]
    )

    # Upload mapping file for crash deobfuscation
    mapping_path = "app/build/outputs/mapping/release/mapping.txt"
    if File.exist?(mapping_path)
      supply(
        json_key_data: ENV["PLAY_SERVICE_ACCOUNT_KEY"],
        package_name: "io.gula.android",
        mapping_path: mapping_path
      )
    end
  end

  desc "Promote build between tracks"
  lane :promote_android do |options|
    from_track = options[:from_track] || "alpha"
    to_track = options[:to_track] || "beta"

    supply(
      json_key_data: ENV["PLAY_SERVICE_ACCOUNT_KEY"],
      package_name: "io.gula.android",
      track: from_track,
      promote_from_track: from_track,
      track_promote_to: to_track
    )
  end

  desc "Capture screenshots for Google Play"
  lane :screenshots_android do
    # Uses Fastlane Screengrab to capture screenshots
    gradle(tasks: ["clean", "assembleDebug", "assembleDebugAndroidTest"])

    screengrab(
      locales: ["en-US", "ar-SA"],
      clear_previous_screenshots: true,
      app_apk_path: "app/build/outputs/apk/debug/app-debug.apk",
      tests_apk_path: "app/build/outputs/apk/androidTest/debug/app-debug-androidTest.apk",
      use_tests_in_packages: ["io.gula.android.screenshots"],
      output_directory: "../fastlane/screenshots/android"
    )
  end

  desc "Submit for app review"
  lane :submit_review do
    supply(
      json_key_data: ENV["PLAY_SERVICE_ACCOUNT_KEY"],
      package_name: "io.gula.android",
      track: "production",
      release_status: "completed",
      rollout: "0.1"  # Start at 10% rollout
    )
  end
end

platform :ios do
  desc "Run all iOS tests"
  lane :test do
    run_tests(
      workspace: "Gula.xcworkspace",
      scheme: "Gula",
      devices: ["iPhone 16 Pro"],
      configuration: "Debug",
      code_coverage: true,
      output_types: "html,junit,json-compilation-database",
      result_bundle: true
    )

    run_tests(
      workspace: "Gula.xcworkspace",
      scheme: "GulaUITests",
      devices: ["iPhone 16 Pro"],
      configuration: "Debug"
    )
  end

  desc "Build iOS IPA"
  lane :build_ios do |options|
    build_type = options[:build_type] || "release"
    export_method = options[:export_method] || "app-store"

    match(type: export_method, readonly: true)

    build_app(
      workspace: "Gula.xcworkspace",
      scheme: "Gula",
      configuration: build_type.capitalize,
      export_method: export_method,
      clean: true,
      include_bitcode: false,
      include_symbols: true,
      derived_data_path: "/tmp/GulaDerivedData"
    )
  end

  desc "Deploy to TestFlight"
  lane :deploy_ios_testflight do |options|
    skip_build = options[:skip_build] || false

    build_ios(build_type: "release", export_method: "app-store") unless skip_build

    upload_to_testflight(
      skip_waiting_for_build_processing: false,
      apple_id: "io.gula.ios",
      distribute_external: options[:external] || false,
      groups: options[:groups] || ["GULA Beta Testers"],
      changelog: options[:changelog] || load_changelog
    )

    # Upload dSYMs to Sentry
    if ENV["SENTRY_AUTH_TOKEN"]
      sentry_upload_dsym(
        auth_token: ENV["SENTRY_AUTH_TOKEN"],
        org_slug: "gula-platform",
        project_slug: "ios",
        dsym_path: "Gula.app.dSYM.zip"
      )
    end
  end

  desc "Submit for App Store review"
  lane :deploy_ios_appstore do |options|
    build_ios(build_type: "release", export_method: "app-store")

    upload_to_app_store(
      skip_metadata: options[:skip_metadata] || false,
      skip_screenshots: options[:skip_screenshots] || false,
      skip_binary_upload: false,
      app_version: options[:version] || current_version,
      submit_for_review: true,
      reject_if_possible: true,
      automatic_release: false,
      phased_release: true,
      app_rating_config: {
        "CARTOON_FANTASY_VIOLENCE" => 0,
        "REALISTIC_VIOLENCE" => 1,
        "PROFANITY_CRUDE_HUMOR" => 0,
        "UNRESTRICTED_WEB_ACCESS" => 0,
        "GAMBLING_CONTESTS" => 0,
        "MEDICAL_TREATMENT" => 1,
        "ALCOHOL_TOBACCO_DRUGS" => 0
      },
      metadata_path: "../fastlane/metadata/ios",
      privacy_url: "https://gulaplatform.com/privacy",
      support_url: "https://gulaplatform.com/support",
      marketing_url: "https://gulaplatform.com"
    )

    # Send Slack notification
    slack(
      message: "GULA Platform v#{current_version} submitted to App Store review",
      channel: "#releases",
      success: true,
      payload: {
        "Version" => current_version,
        "Build" => current_build_number,
        "App" => "GULA Platform - iOS"
      }
    )
  end

  desc "Capture screenshots for App Store"
  lane :screenshots_ios do
    capture_screenshots(
      workspace: "Gula.xcworkspace",
      scheme: "GulaScreenshots",
      output_directory: "../fastlane/screenshots/ios",
      languages: ["en-US", "ar-SA"],
      concurrent_simulators: true,
      devices: ["iPhone 16 Pro", "iPad Pro 13-inch (M4)"]
    )
  end

  desc "Run code signing with match"
  lane :match_development do
    match(type: "development", readonly: false)
  end

  lane :match_ad_hoc do
    match(type: "adhoc", readonly: false)
  end

  lane :match_appstore do
    match(type: "appstore", readonly: false)
  end
end

def load_changelog
  changelog_path = "../fastlane/metadata/android/en-US/release-notes.txt"
  if File.exist?(changelog_path)
    File.read(changelog_path)
  else
    "Bug fixes and performance improvements"
  end
end

def current_version
  version = ENV["VERSION"]
  return version if version

  if platform == :ios
    get_version_number(target: "Gula")
  else
    gradle_version = get_version_name
    gradle_version
  end
end

def current_build_number
  if platform == :ios
    get_build_number
  else
    get_version_code
  end
end

before_all do |lane|
  # Ensure environment is set up
  ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "120"
  ENV["FASTLANE_XCODEBUILD_SETTINGS_RETRIES"] = "3"
end

after_all do |lane|
  slack(
    message: "GULA Platform: #{lane} completed successfully",
    channel: "#releases",
    success: true
  ) if ENV["SLACK_WEBHOOK_URL"]
end

error do |lane, exception|
  slack(
    message: "GULA Platform: #{lane} failed: #{exception.message}",
    channel: "#releases",
    success: false
  ) if ENV["SLACK_WEBHOOK_URL"]
end
