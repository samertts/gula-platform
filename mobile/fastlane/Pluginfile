# Fastlane plugins for GULA Platform CI/CD

# Sentry integration for dSYM uploads and crash reporting
gem 'fastlane-plugin-sentry'

# Firebase App Distribution for internal testing
gem 'fastlane-plugin-firebase_app_distribution'

# Microsoft App Center integration
gem 'fastlane-plugin-appcenter'

# Version management
gem 'fastlane-plugin-versioning'

# Code signing management
gem 'fastlane-plugin-match'

# Slack notifications
gem 'fastlane-plugin-slack'

# GitHub release management
gem 'fastlane-plugin-github'

# Android dependency updates
gem 'fastlane-plugin-supply'

# iOS device management
gem 'fastlane-plugin-produce'

# Changelog generation
gem 'fastlane-plugin-changelog'

# Increment build numbers
gem 'fastlane-plugin-increment_build_number'
