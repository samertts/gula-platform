#include <windows.h>

#define IDI_APP_ICON 101
#define IDI_APP_ICON_SMALL 102

IDI_APP_ICON ICON "app_icon.ico"
IDI_APP_ICON_SMALL ICON "app_icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,1,0,0
 PRODUCTVERSION 2,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "GULA Platform"
            VALUE "FileDescription", "GULA Platform Desktop Application"
            VALUE "FileVersion", "2.1.0.0"
            VALUE "InternalName", "gula_desktop"
            VALUE "LegalCopyright", "Copyright (C) 2025 GULA Platform"
            VALUE "OriginalFilename", "gula_desktop.exe"
            VALUE "ProductName", "GULA Platform"
            VALUE "ProductVersion", "2.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
