    "format": "MSH + MSA two-segment response",
    "ack_codes": {
      "AA": {
        "meaning": "Application Accept",
        "description": "Message was accepted and processed successfully",
        "http_mapping": 200
      },
      "AE": {
        "meaning": "Application Error",
        "description": "Message was syntactically valid but processing failed internally",
        "http_mapping": 500
      },
      "AR": {
        "meaning": "Application Reject",
        "description": "Message was rejected (bad data, unknown patient, etc.)",
        "http_mapping": 400
      }
