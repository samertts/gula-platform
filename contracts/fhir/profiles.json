[
  {
    "profile": "https://gula-platform.org/fhir/profiles/gula-patient",
    "baseResource": "Patient",
    "name": "GULAPatientProfile",
    "title": "GULA Platform Patient Profile",
    "description": "Patient resource mapping from GULA Platform's dual-domain model — Citizen (national registry) and Patient (LIMS per-lab view). Supports Iraq national ID (HMAC-hashed), health number, Arabic names (given + father + family), bilingual address, and tenant isolation via managingOrganization.",
    "mappingSource": "backend/app/national/fhir/patient.py :: FHIRPatientMapper",
    "mappingSourceAlternative": "backend/app/routes/compliance.py :: get_fhir_patient()",
    "mappingRules": {
      "sourceModels": [
        "app.national.domain.citizen.Citizen",
        "app.national.domain.patient.Patient"
      ],
      "fieldMappings": [
        {"fhirPath": "Patient.id", "source": "citizen.fhir_id or citizen.id", "required": true, "type": "string"},
        {"fhirPath": "Patient.identifier[0]", "source": "citizen.health_number", "use": "usual", "type": {"coding": [{"system": "http://terminology.hl7.org/CodeSystem/v2-0203", "code": "MR"}], "text": "Health Number"}, "system": "https://gula.health/identifier/health-number"},
        {"fhirPath": "Patient.identifier[1]", "source": "citizen.national_id_hash", "use": "official", "type": {"coding": [{"system": "http://terminology.hl7.org/CodeSystem/v2-0203", "code": "NI"}], "text": "National ID"}, "system": "https://gula.health/identifier/national-id", "note": "Stored as HMAC-SHA256 hash; only first 16 chars exposed in FHIR output"},
        {"fhirPath": "Patient.name[0]", "source": "citizen.first_name, citizen.last_name, citizen.father_name, citizen.full_name_ar", "use": "official", "note": "Arabic full name in name.text; given = [first_name, father_name]; family = last_name"},
        {"fhirPath": "Patient.gender", "source": "citizen.gender", "binding": "http://hl7.org/fhir/ValueSet/administrative-gender", "values": ["male", "female", "other", "unknown"]},
        {"fhirPath": "Patient.birthDate", "source": "citizen.date_of_birth", "type": "date"},
        {"fhirPath": "Patient.address[0]", "source": "citizen.governorate, citizen.district, citizen.street", "country": "IQ", "use": "home"},
        {"fhirPath": "Patient.telecom", "source": "citizen.phone (mobile)", "source2": "citizen.email (home)"},
        {"fhirPath": "Patient.maritalStatus", "source": "citizen.marital_status"},
        {"fhirPath": "Patient.active", "source": "not citizen.is_deleted", "type": "boolean"},
        {"fhirPath": "Patient.deceasedDateTime", "source": "citizen.deceased_date", "condition": "citizen.is_deceased == true"},
        {"fhirPath": "Patient.deceasedBoolean", "source": "true", "condition": "citizen.is_deceased == true"},
        {"fhirPath": "Patient.generalPractitioner", "source": "patient.created_by -> Practitioner/{id}"},
        {"fhirPath": "Patient.managingOrganization", "source": "patient.lab_id -> Organization/{id}"}
      ]
    },
    "requiredFields": ["resourceType", "id"],
    "terminologyBindings": {
      "gender": {"system": "http://hl7.org/fhir/ValueSet/administrative-gender", "strength": "required"},
      "identifier.type": {"system": "http://terminology.hl7.org/CodeSystem/v2-0203", "strength": "extensible"},
      "maritalStatus": {"system": "http://hl7.org/fhir/ValueSet/marital-status", "strength": "extensible"}
    },
    "referenceRanges": [],
    "examples": [
      {
        "description": "Citizen-to-Patient mapping example",
        "source": "citizen.fhir_id='C-12345', citizen.health_number='HN-98765', citizen.first_name='محمد', citizen.father_name='علي', citizen.last_name='حسن', citizen.gender='MALE'",
        "output": {"resourceType": "Patient", "id": "C-12345", "identifier": [{"use": "usual", "type": {"coding": [{"system": "http://terminology.hl7.org/CodeSystem/v2-0203", "code": "MR"}], "text": "Health Number"}, "system": "https://gula.health/identifier/health-number", "value": "HN-98765"}], "name": [{"use": "official", "family": "حسن", "given": ["محمد", "علي"]}], "gender": "male", "address": [{"use": "home", "city": "بغداد", "country": "IQ"}], "active": true}
      }
    ]
  },
  {
    "profile": "https://gula-platform.org/fhir/profiles/gula-practitioner",
    "baseResource": "Practitioner",
    "name": "GULAPractitionerProfile",
    "title": "GULA Platform Practitioner Profile",
    "description": "Practitioner resource mapping from national Practitioner domain model. Licensed healthcare providers in Iraqi health system with specialty, qualification, and license tracking.",
    "mappingSource": "backend/app/national/fhir/practitioner.py :: FHIRPractitionerMapper",
    "mappingRules": {
      "sourceModels": ["app.national.domain.practitioner.Practitioner"],
      "fieldMappings": [
        {"fhirPath": "Practitioner.id", "source": "practitioner.fhir_id or practitioner.id", "required": true},
        {"fhirPath": "Practitioner.identifier[0]", "source": "practitioner.license_number", "use": "official", "system": "https://gula.health/identifier/license"},
        {"fhirPath": "Practitioner.name[0]", "source": "practitioner.full_name", "use": "official"},
        {"fhirPath": "Practitioner.telecom", "source": "practitioner.phone, practitioner.email"},
        {"fhirPath": "Practitioner.gender", "source": "practitioner.gender", "binding": "http://hl7.org/fhir/ValueSet/administrative-gender"},
        {"fhirPath": "Practitioner.birthDate", "source": "practitioner.date_of_birth"},
        {"fhirPath": "Practitioner.active", "source": "practitioner.is_active", "type": "boolean"},
        {"fhirPath": "Practitioner.specialty", "source": "practitioner.specialty", "condition": "practitioner.specialty is not None"},
        {"fhirPath": "Practitioner.qualification", "source": "practitioner.qualification", "condition": "practitioner.qualification is not None"}
      ]
    },
    "requiredFields": ["resourceType", "id"],
    "terminologyBindings": {
      "gender": {"system": "http://hl7.org/fhir/ValueSet/administrative-gender", "strength": "required"}
    },
    "referenceRanges": []
  },
  {
    "profile": "https://gula-platform.org/fhir/profiles/gula-organization",
    "baseResource": "Organization",
    "name": "GULAOrganizationProfile",
    "title": "GULA Platform Organization Profile",
    "description": "Organization resource mapping from national Organization domain model. Represents healthcare facilities, laboratories, government health directorates, and their hierarchical relationships.",
    "mappingSource": "backend/app/national/fhir/organization.py :: FHIROrganizationMapper",
    "mappingRules": {
      "sourceModels": ["app.national.domain.organization.Organization"],
      "fieldMappings": [
        {"fhirPath": "Organization.id", "source": "org.fhir_id or org.id", "required": true},
        {"fhirPath": "Organization.identifier[0]", "system": "https://gula.health/identifier/org", "value": "org.id"},
        {"fhirPath": "Organization.name", "source": "org.name", "required": true},
        {"fhirPath": "Organization.telecom", "source": "org.phone, org.email"},
        {"fhirPath": "Organization.address[0]", "source": "org.address_line (line), org.city (city), org.governorate (state), org.country (country)", "defaultCountry": "IQ"},
        {"fhirPath": "Organization.active", "source": "org.is_active", "type": "boolean"},
        {"fhirPath": "Organization.type", "source": "org.org_type", "condition": "org.org_type is not None"},
        {"fhirPath": "Organization.partOf", "source": "org.parent_organization_id -> Organization/{id}", "condition": "org.parent_organization_id is not None"}
      ]
    },
    "requiredFields": ["resourceType", "id", "name"],
    "terminologyBindings": {},
    "referenceRanges": []
  },
  {
    "profile": "https://gula-platform.org/fhir/profiles/gula-encounter",
    "baseResource": "Encounter",
    "name": "GULAEncounterProfile",
    "title": "GULA Platform Encounter Profile",
    "description": "Encounter resource mapping from national Encounter domain model. Tracks clinical encounters across outpatient, inpatient, emergency, and virtual settings with ICD-10 diagnosis codes, participant practitioners, and facility locations.",
    "mappingSource": "backend/app/national/fhir/encounter.py :: FHIREncounterMapper",
    "mappingRules": {
      "sourceModels": ["app.national.domain.encounter.Encounter"],
      "fieldMappings": [
        {"fhirPath": "Encounter.id", "source": "encounter.fhir_id or encounter.id", "required": true},
        {"fhirPath": "Encounter.status", "source": "encounter.status", "required": true, "binding": "http://hl7.org/fhir/ValueSet/encounter-status", "validStatuses": ["planned", "in-progress", "onleave", "finished", "cancelled", "entered-in-error", "unknown"]},
        {"fhirPath": "Encounter.class", "source": "encounter.encounter_type", "mapping": {"outpatient": "AMB", "inpatient": "IMP", "emergency": "EMER", "virtual": "VR"}, "system": "http://terminology.hl7.org/CodeSystem/v3-ActCode"},
        {"fhirPath": "Encounter.type[0]", "source": "encounter.encounter_type"},
        {"fhirPath": "Encounter.subject", "source": "encounter.patient_id -> Patient/{id}", "required": true},
        {"fhirPath": "Encounter.participant[0].individual", "source": "encounter.practitioner_id -> Practitioner/{id}", "condition": "encounter.practitioner_id is not None"},
        {"fhirPath": "Encounter.period.start", "source": "encounter.period_start"},
        {"fhirPath": "Encounter.period.end", "source": "encounter.period_end", "condition": "encounter.period_end is not None"},
        {"fhirPath": "Encounter.reasonCode", "source": "encounter.reason_description"},
        {"fhirPath": "Encounter.diagnosis[0].condition", "source": "encounter.diagnosis_code"},
        {"fhirPath": "Encounter.serviceProvider", "source": "encounter.organization_id -> Organization/{id}", "condition": "encounter.organization_id is not None"},
        {"fhirPath": "Encounter.location[0].location", "source": "encounter.facility_id -> Location/{id}", "condition": "encounter.facility_id is not None"}
      ]
    },
    "requiredFields": ["resourceType", "id", "status", "class"],
    "terminologyBindings": {
      "status": {"system": "http://hl7.org/fhir/ValueSet/encounter-status", "strength": "required"},
      "class": {"system": "http://terminology.hl7.org/CodeSystem/v3-ActCode", "strength": "required"}
    },
    "referenceRanges": []
  },
  {
    "profile": "https://gula-platform.org/fhir/profiles/gula-observation-laboratory",
    "baseResource": "Observation",
    "name": "GULALaboratoryObservationProfile",
    "title": "GULA Platform Laboratory Observation Profile (LIMS)",
    "description": "Observation resource mapped from LIMS Result model via result_to_fhir() mapper. Laboratory test results with LOINC coding, quantitative/qualitative values, UCUM units, reference ranges, and v3-ObservationInterpretation flags. Used in the LIMS FHIR endpoint family.",
    "mappingSource": "backend/app/lims/fhir_mappers.py :: result_to_fhir()",
    "mappingRules": {
      "sourceModels": ["app.lims.models.Result"],
      "fieldMappings": [
        {"fhirPath": "Observation.id", "source": "result.fhir_id or f'lims-obs-{result.id}'", "required": true},
        {"fhirPath": "Observation.status", "source": "result.validation_status", "mapping": {"pending": "preliminary", "auto_validated": "final", "validated": "final", "flagged": "preliminary", "rejected": "cancelled"}, "required": true},
        {"fhirPath": "Observation.code", "source": "result.loinc_code or result.test_code", "system": "http://loinc.org", "display": "result.test_name", "required": true},
        {"fhirPath": "Observation.subject", "source": "result.specimen.order.patient_id -> Patient/{id}", "required": true},
        {"fhirPath": "Observation.specimen", "source": "Specimen/lims-spec-{result.specimen_id}"},
        {"fhirPath": "Observation.valueQuantity", "source": "result.value_numeric + result.unit", "system": "http://unitsofmeasure.org", "condition": "result.value_numeric is not None"},
        {"fhirPath": "Observation.valueString", "source": "result.value_text", "condition": "result.value_text is not None"},
        {"fhirPath": "Observation.referenceRange[0].low", "source": "result.ref_range_low", "condition": "ref_range_low or ref_range_high is not None"},
        {"fhirPath": "Observation.referenceRange[0].high", "source": "result.ref_range_high", "condition": "ref_range_low or ref_range_high is not None"},
        {"fhirPath": "Observation.interpretation", "source": "result.flag", "system": "http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation", "mapping": {"high": "H", "low": "L", "critical_high": "HH", "critical_low": "LL", "normal": "N", "panic": "A"}},
        {"fhirPath": "Observation.effectiveDateTime", "source": "result.performed_at"},
        {"fhirPath": "Observation.device", "source": "result.instrument_id -> Device/lims-inst-{id}", "condition": "result.instrument_id is not None"}
      ]
    },
    "requiredFields": ["resourceType", "id", "status", "code", "subject"],
    "terminologyBindings": {
      "code": {"system": "http://loinc.org", "strength": "preferred"},
      "valueQuantity.system": {"system": "http://unitsofmeasure.org", "strength": "required"},
      "interpretation": {"system": "http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation", "strength": "required"}
    },
    "referenceRanges": [
      {
        "type": "normalRange",
        "lowSource": "result.ref_range_low",
        "highSource": "result.ref_range_high",
        "unitSource": "result.unit",
        "description": "Normal reference range from LIMS reference range definitions or test-level defaults",
        "note": "Reference ranges are configured per test_code in the ReferenceRangeDef model (backend/app/lims/models.py) with optional gender and age constraints"
      },
      {
        "type": "interpretationMapping",
        "values": [
          {"flag": "high", "code": "H", "display": "High"},
          {"flag": "low", "code": "L", "display": "Low"},
          {"flag": "critical_high", "code": "HH", "display": "Critical high"},
          {"flag": "critical_low", "code": "LL", "display": "Critical low"},
          {"flag": "normal", "code": "N", "display": "Normal"},
          {"flag": "panic", "code": "A", "display": "Abnormal"}
        ]
      }
    ],
    "examples": [
      {
        "description": "LIMS Result-to-Observation example",
        "source": "result.id=42, result.loinc_code='4544-3', result.test_name='Hemoglobin', result.value_numeric=13.5, result.unit='g/dL', result.ref_range_low=12.0, result.ref_range_high=16.0, result.flag='normal', result.validation_status='validated'",
        "output": {"resourceType": "Observation", "id": "lims-obs-42", "status": "final", "code": {"coding": [{"system": "http://loinc.org", "code": "4544-3", "display": "Hemoglobin"}], "text": "Hemoglobin"}, "valueQuantity": {"value": 13.5, "unit": "g/dL", "system": "http://unitsofmeasure.org", "code": "g/dL"}, "referenceRange": [{"low": {"value": 12.0, "unit": "g/dL"}, "high": {"value": 16.0, "unit": "g/dL"}}], "interpretation": [{"coding": [{"system": "http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation", "code": "N"}], "text": "Normal"}]}
      }
    ]
  },
  {
    "profile": "https://gula-platform.org/fhir/profiles/gula-observation-compliance",
    "baseResource": "Observation",
    "name": "GULAComplianceObservationProfile",
    "title": "GULA Platform Compliance Observation Profile",
    "description": "Observation resource for government compliance/MoH access. Returns lab results as Observations in a Bundle, sourced from the LabResult model with LOINC coding, reference ranges, and interpretation flags.",
    "mappingSource": "backend/app/routes/compliance.py :: get_fhir_observations()",
    "mappingRules": {
      "sourceModels": ["app.models.lab_result.LabResult"],
      "fieldMappings": [
        {"fhirPath": "Observation.id", "source": "str(r.id)", "required": true},
        {"fhirPath": "Observation.status", "source": "'final'", "fixed": true},
        {"fhirPath": "Observation.category", "source": [{"system": "http://terminology.hl7.org/CodeSystem/observation-category", "code": "laboratory", "display": "Laboratory"}]},
        {"fhirPath": "Observation.code.text", "source": "r.test_name"},
        {"fhirPath": "Observation.subject", "source": "Patient/{patient.health_id or order.patient_id}"},
        {"fhirPath": "Observation.effectiveDateTime", "source": "r.created_at"},
        {"fhirPath": "Observation.issued", "source": "r.created_at"},
        {"fhirPath": "Observation.performer[0]", "source": "Organization/{order.lab_id}"},
        {"fhirPath": "Observation.valueQuantity", "source": "r.value + r.unit", "system": "http://unitsofmeasure.org", "condition": "r.value is not None"},
        {"fhirPath": "Observation.valueString", "source": "r.value_text", "condition": "r.value_text is not None"},
        {"fhirPath": "Observation.referenceRange[0].low", "source": "r.normal_range_low"},
        {"fhirPath": "Observation.referenceRange[0].high", "source": "r.normal_range_high"},
        {"fhirPath": "Observation.interpretation", "source": "r.flag", "system": "http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation", "mapping": {"high": "H", "low": "L", "critical_high": "HH", "critical_low": "LL", "normal": "N"}}
      ]
    },
    "requiredFields": ["resourceType", "id", "status", "code", "subject"],
    "terminologyBindings": {
      "category": {"system": "http://terminology.hl7.org/CodeSystem/observation-category", "strength": "required"},
      "valueQuantity.system": {"system": "http://unitsofmeasure.org", "strength": "required"},
      "interpretation": {"system": "http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation", "strength": "required"}
    },
    "referenceRanges": [
      {
        "type": "normalRange",
        "lowSource": "r.normal_range_low",
        "highSource": "r.normal_range_high",
        "unitSource": "r.unit",
        "description": "Normal range from LabResult model fields"
      }
    ]
  },
  {
    "profile": "https://gula-platform.org/fhir/profiles/gula-diagnostic-report",
    "baseResource": "DiagnosticReport",
    "name": "GULADiagnosticReportProfile",
    "title": "GULA Platform DiagnosticReport Profile",
    "description": "DiagnosticReport resource wrapping all laboratory observations from a single order into a reportable document. Mapped from LIMS LabReport model (via report_to_fhir_diagnostic()) and LabOrder model (via compliance endpoint). Includes report status, conclusion summary, and references to individual Observation resources.",
    "mappingSource": "backend/app/lims/fhir_mappers.py :: report_to_fhir_diagnostic(), backend/app/routes/compliance.py :: get_fhir_diagnostic_report()",
    "mappingRules": {
      "sourceModels": ["app.lims.models.LabReport", "app.models.lab_order.LabOrder", "app.models.lab_result.LabResult"],
      "fieldMappings": [
        {"fhirPath": "DiagnosticReport.id", "source": "report.fhir_id or f'lims-dr-{report.id}' (LIMS) | order_id (compliance)", "required": true},
        {"fhirPath": "DiagnosticReport.status", "source": "report.status (LIMS) | order.status (compliance)", "mapping": {"draft": "preliminary", "final": "final", "amended": "amended", "corrected": "amended", "cancelled": "cancelled", "completed": "final", "pending": "registered", "cancelled": "cancelled"}},
        {"fhirPath": "DiagnosticReport.category", "source": [{"system": "http://terminology.hl7.org/CodeSystem/v2-0074", "code": "LAB", "display": "Laboratory"}]},
        {"fhirPath": "DiagnosticReport.code", "source": "http://loinc.org Code=\"11502-2\" Display=\"Laboratory report\"", "system": "http://loinc.org", "fixed": true},
        {"fhirPath": "DiagnosticReport.subject", "source": "order.patient_id -> Patient/{id}", "required": true},
        {"fhirPath": "DiagnosticReport.effectiveDateTime", "source": "order.created_at"},
        {"fhirPath": "DiagnosticReport.issued", "source": "report.generated_at (LIMS) | order.created_at (compliance)"},
        {"fhirPath": "DiagnosticReport.performer[0]", "source": "order.lab_id -> Organization/{id}"},
        {"fhirPath": "DiagnosticReport.result", "source": "references to Observation resources for each test in the order"},
        {"fhirPath": "DiagnosticReport.conclusion", "source": "summary of abnormal findings (compliance)", "condition": "abnormal results exist"},
        {"fhirPath": "DiagnosticReport.basedOn", "source": "ServiceRequest/{order_id}", "condition": "order.doctor_name is not None (compliance)"},
        {"fhirPath": "DiagnosticReport.identifier", "source": "order.order_id (compliance) | report.report_number (LIMS)"}
      ]
    },
    "requiredFields": [],
    "terminologyBindings": {
      "category": {"system": "http://terminology.hl7.org/CodeSystem/v2-0074", "strength": "required"},
      "code": {"system": "http://loinc.org", "strength": "preferred"}
    },
    "referenceRanges": []
  },
  {
    "profile": "https://gula-platform.org/fhir/profiles/gula-specimen",
    "baseResource": "Specimen",
    "name": "GULASpecimenProfile",
    "title": "GULA Platform Specimen Profile",
    "description": "Specimen resource mapping from LIMS Specimen model. Laboratory specimens with barcode tracking, container type, collection details, volume, storage location, and chain of custody. Status is mapped from granular LIMS workflow states to FHIR Specimen status codes.",
    "mappingSource": "backend/app/lims/fhir_mappers.py :: specimen_to_fhir()",
    "mappingRules": {
      "sourceModels": ["app.lims.models.Specimen"],
      "fieldMappings": [
        {"fhirPath": "Specimen.id", "source": "specimen.fhir_id or f'lims-spec-{specimen.id}'", "required": true},
        {"fhirPath": "Specimen.identifier[0]", "source": "specimen.barcode", "system": "urn:gula:lims:specimen"},
        {"fhirPath": "Specimen.status", "source": "specimen.status", "mapping": {"ordered": "available", "collected": "available", "received": "available", "accepted": "available", "rejected": "unavailable", "analyzing": "available", "analyzed": "available", "verified": "available", "validated": "available", "released": "available", "archived": "entered-in-error", "disposed": "entered-in-error"}},
        {"fhirPath": "Specimen.type", "source": "specimen.specimen_type", "system": "http://gula.iq/CodeSystem/specimen-type"},
        {"fhirPath": "Specimen.collection.collectedDateTime", "source": "specimen.collection_time", "condition": "specimen.collection_time is not None"},
        {"fhirPath": "Specimen.collection.collector", "source": "specimen.collected_by -> Practitioner/{id}", "condition": "specimen.collected_by is not None"},
        {"fhirPath": "Specimen.collection.bodySite", "source": "specimen.collection_site", "system": "http://snomed.info/sct", "condition": "specimen.collection_site is not None"},
        {"fhirPath": "Specimen.collection.quantity", "source": "specimen.volume_ml (mL)", "condition": "specimen.volume_ml is not None"},
        {"fhirPath": "Specimen.container[0].type", "source": "specimen.container_type", "system": "http://gula.iq/CodeSystem/container-type", "condition": "specimen.container_type is not None"},
        {"fhirPath": "Specimen.receivedTime", "source": "specimen.received_at"},
        {"fhirPath": "Specimen.note", "source": "specimen.storage_id -> 'Storage: {id}'", "condition": "specimen.storage_id is not None"}
      ]
    },
    "requiredFields": [],
    "terminologyBindings": {
      "type": {"system": "http://gula.iq/CodeSystem/specimen-type", "strength": "extensible"},
      "collection.bodySite": {"system": "http://snomed.info/sct", "strength": "preferred"},
      "container.type": {"system": "http://gula.iq/CodeSystem/container-type", "strength": "extensible"}
    },
    "referenceRanges": [],
    "statusMapping": {
      "sourceStates": ["ordered", "collected", "received", "accepted", "processing", "analyzing", "analyzed", "verified", "validated", "released"],
      "targetStates": {"available": "Specimen is available for analysis or has been analyzed", "unavailable": "Specimen rejected (unsuitable for analysis)", "entered-in-error": "Specimen archived or disposed"},
      "note": "Finer-grained LIMS statuses (11 states) are collapsed into the 3 FHIR Specimen statuses"
    }
  },
  {
    "profile": "https://gula-platform.org/fhir/profiles/gula-service-request",
    "baseResource": "ServiceRequest",
    "name": "GULAServiceRequestProfile",
    "title": "GULA Platform ServiceRequest Profile",
    "description": "ServiceRequest resource mapping from LIMS Order and LabOrder models. Represents a clinician's order for laboratory tests with accession number, priority (routine/urgent/stat), ordering provider, and lab performer.",
    "mappingSource": "backend/app/lims/fhir_mappers.py :: order_to_fhir_service_request(), backend/app/routes/compliance.py :: get_fhir_service_request()",
    "mappingRules": {
      "sourceModels": ["app.lims.models.Order", "app.models.lab_order.LabOrder"],
      "fieldMappings": [
        {"fhirPath": "ServiceRequest.id", "source": "order.fhir_id or f'lims-sr-{order.id}' (LIMS) | order_id (compliance)", "required": true},
        {"fhirPath": "ServiceRequest.status", "source": "'active' (LIMS) | 'completed' if order.status == 'completed' else 'active' (compliance)"},
