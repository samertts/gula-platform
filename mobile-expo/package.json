{
  "name": "@gula/mobile-expo",
  "version": "1.0.0",
  "private": true,
  "overrides": {
    "image-size": "$image-size",
    "postcss": "8.5.26",
    "uuid": "11.1.1"
  },
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
