    "expo-status-bar": "~3.0.0",
    "image-size": "file:vendor/image-size",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "jest": "^29.7.0",
    "expo-doctor": "1.18.24",
    "jest-expo": "~54.0.0",
    "typescript": "~5.9.2"
  }
