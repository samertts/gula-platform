# GULA DEMO — synthetic environment only. Copy to .env.demo on the demo host.
# Never reuse values from the production .env file.
GULA_IMAGE_PREFIX=ghcr.io/samertts/gula-platform
GULA_IMAGE_TAG=main

GULA_DEMO_POSTGRES_PASSWORD=replace-with-a-unique-demo-postgres-password
GULA_DEMO_REDIS_PASSWORD=replace-with-a-unique-demo-redis-password
GULA_DEMO_SECRET_KEY=replace-with-a-unique-demo-session-secret-at-least-32-characters
GULA_DEMO_REFRESH_TOKEN_SECRET=replace-with-a-unique-demo-refresh-secret-at-least-32-characters
GULA_DEMO_ENCRYPTION_KEY=replace-with-a-unique-demo-encryption-key
GULA_DEMO_NID_HMAC_KEY=replace-with-a-unique-demo-nid-hmac-key
GULA_DEMO_AUDIT_ANCHOR_KEY=replace-with-a-unique-demo-audit-anchor-key
