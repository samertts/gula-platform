# =============================================================================
# GULA Platform — .gitignore
# =============================================================================

# ── Environment & Secrets ──────────────────────────────────────────────────────
.env
.env.*.local
*.credentials
*.secret
*.auth
config/secrets/
secrets/

# ── Deployment ────────────────────────────────────────────────────────────────
.deploy/
.env.deploy
*.tfstate
*.tfstate.backup
terraform/.terraform/
*.plan

# ── Python ────────────────────────────────────────────────────────────────────
venv/
.venv/
__pycache__/
.coverage
coverage.xml
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.so

# ── JavaScript / TypeScript ────────────────────────────────────────────────────
node_modules/
dist/
build/
.next/
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Logs ───────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Data ───────────────────────────────────────────────────────────────────────
data/db/
*.sqlite3

# ── Reports & Artifacts ────────────────────────────────────────────────────────
reports/
trivy_*.json
codeql_*.md
enterprise_security_*.md
security_root_causes.md

# ── AI Governor runtime state ───────────────────────────────────────────────────
.ai/core/governor/state/

# ── AI Kernel runtime state ─────────────────────────────────────────────────────
.ai/core/kernel/state/

# ── OS ─────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ── IDE ────────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.iml

# ── Docker ─────────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ── Cryptographic Material ─────────────────────────────────────────────────────
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
*.jks
*.keystore
config/ssl/*

# ── Build Artifacts ────────────────────────────────────────────────────────────
wheels
openapi.json
*.whl
*.egg

# ── Terraform ──────────────────────────────────────────────────────────────────
*.terraform.lock.hcl
crash.log

# ── Security Scanning ──────────────────────────────────────────────────────────
.semgrep/logs/

# production secrets — never commit
.env.production

# ── Orchestrator runtime state ────────────────────────────────────────────────
.ai/core/orchestrator/state/checkpoints/
.ai/core/orchestrator/state/missions/
