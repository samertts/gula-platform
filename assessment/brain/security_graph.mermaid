# Security Architecture — GULA Platform

graph TB
    subgraph Perimeter[Perimeter Security]
        WAF[WAF / Rate Limiting]
        TLS[TLS 1.3]
        CSP[CSP Headers]
        HSTS[HSTS]
    end

    subgraph Auth[Authentication Layer]
        JWT[JWT Access Token]
        REF[Refresh Token]
        MFA[MFA (Future)]
        SESSION[Session Management]
    end

    subgraph Authz[Authorization Layer]
        RBAC[RBAC - 9 Roles]
        ABAC[ABAC (Future)]
        PERM[13 Permissions]
        LAB[Tenant Isolation]
    end

    subgraph Encryption[Data Protection]
        FERNET[Fernet Encryption]
        HMAC[HMAC Signatures]
        NID[National ID Encryption]
        QR[QR + HMAC Tokens]
    end

    subgraph Audit[Audit & Monitoring]
        AUD[Audit Log Chain]
        IDS[Intrusion Detection]
        MET[Metrics / Prometheus]
        ALERT[Alert Webhook]
    end

    subgraph Safety[Safety Measures]
        CB[Circuit Breaker]
        KILL[Kill Switch]
        AHEAL[Auto-Heal]
        ACL[Adaptive Concurrency]
    end

    TLS --> JWT
    JWT --> RBAC
    RBAC --> PERM
    PERM --> LAB
    FERNET --> NID
    HMAC --> QR
    AUD --> IDS
    CB --> AHEAL
