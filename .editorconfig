# EditorConfig for GULA Platform
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 120

[*.{yml,yaml}]
indent_size = 2

[*.{json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = 80

[Makefile]
indent_style = tab

[{package.json,.prettierrc}]
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 120

[*.{ts,tsx,js,jsx}]
indent_size = 2
max_line_length = 120

[*.css,*.scss]
indent_size = 2

[*.{sh,bash,zsh}]
indent_size = 2

[Dockerfile]
indent_size = 4
