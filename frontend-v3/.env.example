VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=GULA Platform
VITE_APP_VERSION=2.5.0

# ── Isolated Demo / Preview Access (temporary, disabled by default) ──
# Enable ONLY deliberately for a demonstration environment.
# VITE_DEMO_MODE_ENABLED=true
# Required when enabled; an ISO-8601 timestamp. When missing/invalid/expired the
# demo mode fails CLOSED and is disabled. Must be set at build time.
# VITE_DEMO_MODE_EXPIRES_AT=2099-01-01T00:00:00Z
