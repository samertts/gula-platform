{
  "name": "gula-frontend-v3",
  "private": true,
  "version": "2.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=5173 --host=0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --exclude 'e2e/**'",
    "verify:unification": "node scripts/verify-frontend-unification.mjs",
    "verify:contracts": "node scripts/verify-contract-governance.mjs",
    "verify:integration-boundary": "node scripts/verify-integration-boundary.mjs",
    "generate:data-source-inventory": "node scripts/data-source-inventory.mjs",
    "verify:data-sources": "node scripts/verify-data-source-governance.mjs",
    "generate:route-gate": "node ../scripts/contract-audit/generate-frontend-page-map.mjs",
    "verify:audit-artifacts": "node ../scripts/contract-audit/verify-audit-artifacts.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm verify:unification && pnpm verify:contracts && pnpm verify:integration-boundary && pnpm generate:data-source-inventory && pnpm verify:data-sources && pnpm generate:route-gate && pnpm verify:audit-artifacts && pnpm build",
    "test:watch": "vitest --passWithNoTests --exclude 'e2e/**'",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.7.0",
    "clsx": "^2.1.0",
    "i18next": "^24.0.0",
    "lucide-react": "^0.460.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^15.0.0",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.0.0",
    "jsdom": "^25.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0",
    "workbox-window": "^7.4.1"
  }
}
