# =============================================================================
# GULA Platform v2.1 — Production Environment
# منصة غولا الصحية — الإعدادات الإنتاجية
#
# ⚠️  CRITICAL: Never commit this file to git with real values.
#              Every CHANGE_ME below MUST be replaced before deployment.
#
# KEY GENERATION COMMANDS:
#   SECRET_KEY / REFRESH_TOKEN_SECRET:
#       python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#   ENCRYPTION_KEY (Fernet):
#       python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   NID_HMAC_KEY / DEVICE_HMAC_KEY:
#       python3 -c "import secrets; print(secrets.token_hex(32))"
#   POSTGRES_PASSWORD / REDIS_PASSWORD:
#       python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#   GULA_ADMIN_PASSWORD:
#       python3 -c "import secrets; print(secrets.token_urlsafe(20))"
# =============================================================================

# ── Environment ───────────────────────────────────────────────────────────────
ENV=production
DEBUG=false
LOG_LEVEL=warning

# ── Database (PostgreSQL 16 — NOT MySQL) ──────────────────────────────────────
# IMPORTANT: This platform uses PostgreSQL exclusively. MySQL is NOT supported.
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_POSTGRES_PASSWORD@postgres:5432/labdb
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=7
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
PG_SHARED_BUFFERS=256MB

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis:6379

# ── JWT & Auth Secrets (MUST differ from each other) ──────────────────────────
SECRET_KEY=CHANGE_ME_run_python_secrets_token_urlsafe_64
REFRESH_TOKEN_SECRET=CHANGE_ME_run_python_secrets_token_urlsafe_64_DIFFERENT
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_EXPIRE_MINUTES=30

# ── Encryption (Fernet AES-256) ───────────────────────────────────────────────
# CRITICAL: DO NOT CHANGE after first data is stored.
ENCRYPTION_KEY=CHANGE_ME_run_Fernet_generate_key

# ── National ID HMAC ──────────────────────────────────────────────────────────
# CRITICAL: DO NOT CHANGE after first registration.
NID_HMAC_KEY=CHANGE_ME_run_secrets_token_hex_32

# ── Device HMAC (lab analyzers) ───────────────────────────────────────────────
DEVICE_HMAC_KEY=CHANGE_ME_run_secrets_token_hex_32
ALLOWED_DEVICE_IDS=

# ── Master Admin Bootstrap ────────────────────────────────────────────────────
GULA_ADMIN_EMAIL=admin@gula-platform.org
GULA_ADMIN_NAME=GULA Platform Admin
GULA_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# ── Platform ──────────────────────────────────────────────────────────────────
BASE_URL=https://gula-platform.org
CORS_ORIGINS=https://gula-platform.org,http://gula-platform.org
ENABLE_API_DOCS=false

# ── Performance ───────────────────────────────────────────────────────────────
WEB_CONCURRENCY=2
MAX_CONCURRENT_REQUESTS=100
MAX_REQUEST_BODY_MB=10
MAX_UPLOAD_SIZE_MB=2
RATE_LIMIT_AUTH=10
RATE_LIMIT_PUBLIC=60

# ── Monitoring (optional — enable with: docker compose --profile monitoring up) ─
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# ── Backup ────────────────────────────────────────────────────────────────────
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# ── Mobile Push (optional) ────────────────────────────────────────────────────
FCM_SERVER_KEY=
APNS_KEY=

# ── Timezone ──────────────────────────────────────────────────────────────────
TZ=Asia/Baghdad
