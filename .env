# =============================================================================
# GULA PLATFORM - Environment Configuration
# =============================================================================
# SECURITY: This file must NEVER be committed to version control.
# Use HashiCorp Vault for production secrets management.
# =============================================================================

# --- AI Provider (Executive Order 4: Local AI Only) ---
AI_PROVIDER=ollama
AI_FALLBACK=false
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3

# --- Database ---
POSTGRES_PASSWORD=gula_secure_2024
POSTGRES_USER=postgres
POSTGRES_DB=labdb
DATABASE_URL=postgresql://postgres:gula_secure_2024@pgbouncer:5432/labdb
DATABASE_READ_URL=postgresql://postgres:gula_secure_2024@postgres-replica:5432/labdb

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- RabbitMQ ---
RABBITMQ_USER=gula
RABBITMQ_PASS=gula_rabbit_2024
RABBITMQ_VHOST=gula
RABBITMQ_URL=amqp://gula:gula_rabbit_2024@rabbitmq:5672/gula

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- MinIO Object Storage ---
MINIO_ROOT_USER=gula_minio
MINIO_ROOT_PASSWORD=gula_minio_2024
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_REPORTS=medical-reports
MINIO_BUCKET_IMAGES=lab-images
MINIO_BUCKET_RESULTS=device-results

# --- Keycloak Identity ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=gula_keycloak_2024
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=gula-platform
KEYCLOAK_CLIENT_ID=gula-api

# --- HashiCorp Vault ---
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=gula_vault_root_token

# --- Monitoring ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=gula_grafana_2024

# --- Circuit Breaker Settings (Executive Order 7) ---
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30
CIRCUIT_BREAKER_EXPECTED_EXCEPTION=Exception

# --- Retry Settings (Executive Order 8) ---
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=2

# --- Backup Settings (Executive Order 20) ---
BACKUP_HOURLY_ENABLED=true
BACKUP_DAILY_ENABLED=true
BACKUP_S3_BUCKET=gula-backups
BACKUP_RETENTION_DAYS=30

# IMPORTANT: The following external AI providers are DISABLED (Executive Order 4)
# DEEPSEEK_API_KEY=disabled
# GEMINI_API_KEY=disabled
# TOGETHER_API_KEY=disabled
