{
 "catalog_version": "1.0",
 "program": "PROGRAM-01",
 "workflows": [
  {
   "name": "Order creation with results",
   "trigger": "POST /orders or POST /batch/orders",
   "status": "complete",
   "steps": [
    "idempotency check (Redis 24h)",
    "patient scoped to lab",
    "doctor validation",
    "LabOrder(status=completed)",
    "LabResult per test with flag",
    "public token + hash per result",
    "audit log_action",
    "sharing links",
    "critical alert",
    "events order.created/result.critical"
   ],
   "entities": [
    "LabOrder",
    "LabResult",
    "Patient",
    "LabUser",
    "AuditLog"
   ],
   "apis": [
    "POST /orders",
    "GET /orders",
    "GET /orders/{id}",
    "POST /batch/orders"
   ]
  },
  {
   "name": "Sample workflow",
   "trigger": "technician registers sample / analyzer submission",
   "status": "complete",
   "steps": [
    "create_sample (barcode)",
    "status transitions collected\u2192received\u2192processing\u2192analyzed (or rejected with reason)",
    "audit"
   ],
   "entities": [
    "Sample"
   ],
   "apis": [
    "POST /samples",
    "GET /samples",
    "GET /samples/{barcode}",
    "PUT /samples/{barcode}"
   ]
  },
  {
   "name": "Analyzer device result ingestion",
   "trigger": "POST /device/results",
   "status": "complete",
   "steps": [
    "rate limit 100/min/IP",
    "sample lookup",
    "assert_not_locked(423)/assert_not_cancelled(409)",
    "enforce_transition(order,'completed')",
    "create results",
    "sample status analyzed",
    "result.critical event"
   ],
   "entities": [
    "Sample",
    "LabOrder",
    "LabResult",
    "DeviceSubmission"
   ],
   "apis": [
    "POST /device/results"
   ]
  },
  {
   "name": "Result verification / order validation (locking)",
   "trigger": "POST /orders/{id}/validate or PUT /test-results/{id}/verify",
   "status": "complete",
   "steps": [
    "role check (admin/master_admin/doctor, doctor scoped)",
    "order must have results",
    "enforce_transition\u2192validated",
    "atomic conditional UPDATE locked_at IS NULL",
    "validated/validated_by/validated_at/locked_at",
    "audit",
    "order.validated event"
   ],
   "entities": [
    "LabOrder",
    "LabResult"
   ],
   "apis": [
    "POST /orders/{id}/validate",
    "POST /orders/{id}/cancel",
    "PUT /test-results/{id}/verify",
    "POST /test-results/validate"
   ]
  },
  {
   "name": "Public result delivery (token-based)",
   "trigger": "GET /r/{token} or /r/{token}/pdf or /qr/qr/{token}",
   "status": "complete",
   "steps": [
    "token lookup by hash",
    "IP rate limit",
    "optional phone+name verification",
    "result + interpretation EN/AR",
    "PDF (Hijri+Gregorian, Arabic RTL)"
   ],
   "entities": [
    "LabResult",
    "Patient"
   ],
   "apis": [
    "GET /results/r/{token}",
    "GET /results/r/{token}/pdf",
    "GET /qr/qr/{token}",
    "GET /qr/qr-medical/{token}"
   ]
  },
  {
   "name": "Quality control (Westgard)",
   "trigger": "POST /qc or POST /qc/batch",
   "status": "complete",
   "steps": [
    "evaluate_westgard_full 6-rule engine (1-2s, 2-2s before 1-2s, R-4s, 4-1s, 10-xbar, 1-3s)",
    "prior QC history from DB",
    "rule violation persisted",
    "summary per test/level"
   ],
   "entities": [
    "QualityControl"
   ],
   "apis": [
    "POST /qc",
    "POST /qc/batch",
    "GET /qc",
    "GET /qc/summary"
   ]
  },
