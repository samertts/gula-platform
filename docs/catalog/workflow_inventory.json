 ],
 "state_machines": {
  "order": "pending \u2192 completed \u2192 validated (terminal, locked) | cancelled (terminal); enforce_transition 409, assert_not_locked 423, assert_not_cancelled 409",
  "sample": "collected \u2192 received \u2192 processing \u2192 analyzed | rejected (reason required); free transitions within set",
  "referral": "draft \u2192 sent \u2192 accepted | rejected | cancelled \u2192 completed (only from accepted)",
  "claim": "draft \u2192 validated \u2192 submitted (terminal, service-enforced)",
  "consent": "active \u2192 revoked (auto-revoke on regrant; \u226472h expiry)",
  "workflow_execution": "pending \u2192 running \u2192 completed|failed|paused|cancelled|suspended|timed_out; failed/timed_out \u2192 running|compensated|rolled_back",
  "clinical_state": "computed not persisted: can_release_results / requires_physician_ack (not wired)"
 },
 "events_outbox": {
  "constants": [
   "order.created",
   "order.validated",
   "order.cancelled",
   "result.critical",
   "sample.rejected",
   "patient.created",
   "result.updated",
   "result.validated",
   "alert.triggered",
   "sample.collected"
  ],
  "producers": {
   "order_service": [
    "order.created",
    "result.critical",
    "order.validated",
    "order.cancelled"
   ],
   "test_result_service": [
    "result.critical"
   ],
   "national_streaming": [
    "fhir.*",
    "hl7.*",
    "table.*"
   ],
   "claims_service": [
    "claim_submitted"
   ],
   "care_continuum": [
    "referral timeline"
   ],
   "data_platform_service": [
    "data_platform.golden_record.created",
    "data_platform.merge.completed"
   ],
   "mpi_resolver": [
    "create/manual_merge"
   ],
   "document_intelligence": [
    "retention/legal-hold/deletion"
   ]
  },
  "consumers": "NONE - zero events.on/subscribe registrations in app code"
 },
 "background_jobs": {
  "in_process": [
   {
    "name": "OutboxWorker.background_loop",
    "cadence": "10s (2s on backlog)",
    "purpose": "drain outbox \u2192 EventBus; purge >30d daily"
   },
   {
    "name": "RecoveryWorker.background_loop",
    "cadence": "continuous",
    "purpose": "circuit-breaker recovery probes"
   },
   {
    "name": "_health_alert_loop",
    "cadence": "60s",
    "purpose": "health watchdog alerting (GREEN/YELLOW/RED)"
   },
   {
    "name": "_adaptive_concurrency_loop",
    "cadence": "30s",
    "purpose": "adaptive concurrency cap"
   },
   {
    "name": "auto_repair.run",
    "cadence": "30s (actions 30-300s cooldown)",
    "purpose": "memory GC, circuit probe, pool recycle, Redis reconnect, outbox poll normalization"
   },
   {
    "name": "edge_maintenance_loop",
    "cadence": "continuous",
    "purpose": "edge device maintenance"
   },
   {
    "name": "TaskWorker",
    "cadence": "5s",
    "purpose": "drain task queue; handlers: national_notification_deliver"
   }
  ],
  "os_cron": [
   {
    "name": "auto_heal.sh",
    "cron": "*/5 * * * *",
    "purpose": "container watchdog/restart"
   },
   {
    "name": "self_heal.py ASHS",
    "cron": "* * * * *",
    "purpose": "API health signals \u2192 repair (per-signal file cooldown)"
   },
   {
    "name": "monitor.sh",
    "cron": "*/5 * * * *",
    "purpose": "/health/ready check + Telegram alert"
   },
   {
    "name": "backup.sh daily",
    "cron": "0 2 * * *",
    "purpose": "PG backup AES-256 encrypted"
   },
   {
    "name": "backup.sh hourly",
    "cron": "0 * * * *",
    "purpose": "hourly incremental backup"
   },
   {
    "name": "backup-verification.sh",
    "cron": "0 6 * * *",
    "purpose": "restore drill / backup verify (337 tables)"
   },
   {
    "name": "cert-renew.sh",
    "cron": "0 3 * * *",
    "purpose": "Let's Encrypt renewal"
   }
  ]
 }
