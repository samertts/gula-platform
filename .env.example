# GULA Platform - Environment Configuration Example
# Copy to .env and fill in your values.
# WARNING: Never commit .env or .env.production to version control.
# In production, ALL of these come from the orchestrator (docker compose .env,
# CI secrets, or k8s External Secrets Operator) - the backend reads os.getenv
# at import time; it does not read .env files itself.

# ── Runtime ────────────────────────────────────────────────────────────────
ENV=development
RUNTIME_MODE=api
BASE_URL=http://localhost:3000
STARTUP_TIMEOUT_SECONDS=120

# ── Core secrets (REQUIRED in production - fail-fast if missing/weak) ─────
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-secret-key
REFRESH_TOKEN_SECRET=change-me-to-a-random-refresh-secret
ENCRYPTION_KEY=change-me-to-a-32-byte-base64-key
NID_HMAC_KEY=change-me-to-a-random-hex-key
AUDIT_ANCHOR_KEY=change-me-to-a-random-anchor-key

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/gula
POSTGRES_PASSWORD=change-me-to-a-secure-password
READ_REPLICA_ENABLED=false
READ_REPLICA_URL=
# Pool tuning (optional)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://:change-me@localhost:6379/0
REDIS_PASSWORD=change-me-to-a-secure-password
REDIS_SENTINEL_HOSTS=
REDIS_SENTINEL_MASTER=
REDIS_CLUSTER_NODES=

# ── Cache ──────────────────────────────────────────────────────────────────
CACHE_ENABLED=true
CACHE_L1_TTL=60
CACHE_L2_TTL=300
CACHE_L1_MAX_SIZE=1024
CACHE_METRICS_ENABLED=false

# ── Auth / JWT ─────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
JWT_EXPIRE_HOURS=24
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Rate limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_AUTH=10
RATE_LIMIT_PUBLIC=60

# ── Request / upload limits ────────────────────────────────────────────────
MAX_REQUEST_BODY_MB=10
MAX_UPLOAD_SIZE_MB=20

# ── Bootstrap & seeding ────────────────────────────────────────────────────
ENABLE_BOOTSTRAP=true
ENABLE_NATIONAL_BOOTSTRAP=true
ENABLE_DEMO_DATA=false
BOOTSTRAP_COUNTRY=IQ
BOOTSTRAP_LANGUAGE=ar
BOOTSTRAP_TIMEZONE=Asia/Baghdad
# Bootstrap admin accounts (production: set strong passwords or hashes)
# *_PASSWORD_HASH variants (bcrypt hash) take precedence over *_PASSWORD.
MASTER_ADMIN_NID=
MINISTRY_ADMIN_EMAIL=
MINISTRY_ADMIN_PASSWORD=
DIRECTORATE_ADMIN_EMAIL=
DIRECTORATE_ADMIN_PASSWORD=
LAB_MANAGER_EMAIL=
LAB_MANAGER_PASSWORD=
ORGANIZATION_ADMIN_EMAIL=
ORGANIZATION_ADMIN_PASSWORD=
AUDITOR_EMAIL=
AUDITOR_PASSWORD=
SECURITY_OFFICER_EMAIL=
SECURITY_OFFICER_PASSWORD=
# Pre-hashed bcrypt variants (optional alternative to the passwords above)
MINISTRY_ADMIN_PASSWORD_HASH=
DIRECTORATE_ADMIN_PASSWORD_HASH=
LAB_MANAGER_PASSWORD_HASH=
ORGANIZATION_ADMIN_PASSWORD_HASH=
AUDITOR_PASSWORD_HASH=
SECURITY_OFFICER_PASSWORD_HASH=

# ── Docs / observability ───────────────────────────────────────────────────
ENABLE_API_DOCS=false
METRICS_BEARER_TOKEN=change-me-to-a-long-random-token
GRAFANA_PASSWORD=change-me-to-a-secure-password
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=gula-backend

# ── Local AI (Ollama) - self-hosted first ──────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── Commercial AI (optional, evaluated only) ───────────────────────────────
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_CLINICAL_MODEL=gemini-2.0-flash
GROQ_API_KEY=

# ── Mobile push (optional) ─────────────────────────────────────────────────
FCM_SERVER_KEY=
APNS_KEY=

# ── Email (Resend — production email provider) ──────────────────────────────
# RESEND_API_KEY: get it from https://resend.com/api-keys.
# Store it ONLY in .env (local development) or the hosting platform's
# Secrets/Environment Variables (production). Never commit it to Git.
# The backend fails at startup if RESEND_API_KEY is missing in production.
RESEND_API_KEY=
EMAIL_FROM=noreply@gula-platform.org
# Optional tuning
RESEND_TIMEOUT_SECONDS=30
RESEND_MAX_RETRIES=3

# ── Telegram Bot (production notification provider) ──────────────────────────
# TELEGRAM_BOT_TOKEN: create a bot with @BotFather and copy its token.
# Store it ONLY in .env (local development) or the hosting platform's
# Secrets/Environment Variables (production). Never commit it to Git.
# The backend fails at startup if TELEGRAM_BOT_TOKEN is missing in
# production while TELEGRAM_NOTIFICATIONS_ENABLED=true.
# chat_id is NOT configured here — supply it dynamically when sending.
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFICATIONS_ENABLED=true
# Optional tuning
TELEGRAM_TIMEOUT_SECONDS=30
TELEGRAM_MAX_RETRIES=3
# ── Enterprise Telegram (PROGRAM-COMM-002A) ──────────────────────────────────
# Webhook mode: set TELEGRAM_WEBHOOK_URL to the public endpoint that proxies
# to /webhooks/telegram/update. Leave empty for polling mode.
# TELEGRAM_WEBHOOK_URL=https://gula-platform.org/webhooks/telegram/update
# Secret returned in X-Telegram-Bot-Api-Secret-Token and validated on every
# inbound update — like TELEGRAM_BOT_TOKEN, keep it out of the repo.
TELEGRAM_WEBHOOK_SECRET_TOKEN=
# polling | webhook | auto
TELEGRAM_MODE=auto
TELEGRAM_WEBHOOK_MAX_CONNECTIONS=40
# Outbound rate limiting (token bucket per minute) + per-chat flood guard.
TELEGRAM_RATE_PER_MINUTE=30
TELEGRAM_MAX_PER_CHAT=0

# ── National adapters (MOI / residency / insurance) ───────────────────────
GULA_ADAPTER_MODE=local
GULA_ADAPTER_MODE_NID=local
GULA_ADAPTER_MODE_RESIDENCY=local
GULA_ADAPTER_MODE_INSURANCE=local
GULA_ADAPTER_MODE_CLOUDFLARE=local
MOI_NID_API_URL=
MOI_NID_API_KEY=
RESIDENCY_API_URL=
RESIDENCY_API_KEY=
INSURANCE_API_URL=
INSURANCE_API_KEY=

# ── Object storage (Cloudflare R2 / Supabase) ──────────────────────────────
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_R2_BUCKET=
CF_ZONE_ID=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ── Feature flags ──────────────────────────────────────────────────────────
ENABLE_ADS=false
ENABLE_FINANCIAL_ENGINE=false
FEATURE_BACKGROUND_TASKS=true
KERNEL_ENABLE_BACKGROUND=true
KERNEL_ENABLE_CONFIG=true
KERNEL_ENABLE_EVENT_BUS=true
KERNEL_ENABLE_FEATURES=true
KERNEL_ENABLE_GATEWAY=true
KERNEL_ENABLE_PLUGINS=true
KERNEL_ENABLE_TENANT=true
KERNEL_KILL_SWITCH=
KERNEL_DEGRADED=false

# ── SNDHS (national health system) ─────────────────────────────────────────
SNDHS_ENABLE_NATIONAL_ID=true
SNDHS_ENABLE_VISITS=true

# ── PaaS identifiers (optional, legacy) ────────────────────────────────────
DIGITALOCEAN_APP_ID=
RENDER_SERVICE_ID=
