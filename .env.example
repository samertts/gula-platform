# =============================================================================
# GULA Platform v2.1.0 - Environment Variables Template
# منصة غولا الصحية - متغيرات البيئة
#
# Copy this file to .env and fill in production values
# نسخ هذا الملف إلى .env وتعبئة القيم الإنتاجية
#
# Generate ENCRYPTION_KEY:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Generate SECRET_KEY:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# =============================================================================

# ─── Environment ─────────────────────────────────────────────────────────────
ENV=production

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/labdb

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME@redis:6379

# ─── Application Security ────────────────────────────────────────────────────
# JWT secret for access tokens (change this!)
SECRET_KEY=CHANGE_ME_GENERATE_WITH_secrets.token_urlsafe(64)

# Refresh token secret (can be different from SECRET_KEY for extra security)
REFRESH_TOKEN_SECRET=CHANGE_ME_GENERATE_WITH_secrets.token_urlsafe(64)

# Refresh token lifetime in days (default: 30)
REFRESH_TOKEN_EXPIRE_DAYS=30

# Fernet encryption key for sensitive data
# MUST be a valid 32-byte URL-safe base64 key
ENCRYPTION_KEY=CHANGE_ME_FROM_Fernet.generate_key()

# Stable HMAC key for national ID hashing (DO NOT CHANGE after first run!)
# If changed, all national ID lookups will break
NID_HMAC_KEY=CHANGE_ME_STABLE_KEY_FOR_NATIONAL_ID_HASHING

# ─── JWT Settings ────────────────────────────────────────────────────────────
JWT_EXPIRE_HOURS=8

# ─── Platform ────────────────────────────────────────────────────────────────
BASE_URL=https://gula-platform.org
CORS_ORIGINS=https://gula-platform.org,http://gula-platform.org

# ─── Master Admin ────────────────────────────────────────────────────────────
GULA_ADMIN_EMAIL=admin@gula-platform.org
GULA_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
GULA_ADMIN_NAME=GULA Admin

# ─── API Documentation ───────────────────────────────────────────────────────
# Set to "true" to enable /docs and /redoc endpoints in production
# Useful for government testers and mobile developers
ENABLE_API_DOCS=true

# ─── Upload Limits ───────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=2
MAX_REQUEST_BODY_MB=10

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_AUTH=10
RATE_LIMIT_PUBLIC=30

# ─── Mobile Notifications (Optional) ────────────────────────────────────────
# Firebase Cloud Messaging (for Android push notifications)
FCM_SERVER_KEY=

# Apple Push Notification Service (for iOS push notifications)
APNS_KEY=

# ─── RabbitMQ (Optional - for enterprise stack) ──────────────────────────────
RABBITMQ_USER=gula
RABBITMQ_PASS=CHANGE_ME_RABBIT_PASSWORD
RABBITMQ_URL=amqp://gula:CHANGE_ME@rabbitmq:5672/gula

# ─── MinIO Object Storage (Optional) ────────────────────────────────────────
MINIO_ROOT_USER=gula_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_ACCESS_KEY=gula_minio
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET
MINIO_SECURE=true

# ─── Keycloak (Optional - for enterprise SSO) ───────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_PASSWORD

# ─── Vault (Optional - for secrets management) ───────────────────────────────
VAULT_TOKEN=CHANGE_ME_VAULT_TOKEN

# ─── Monitoring (Optional) ──────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# ─── AI (Optional) ──────────────────────────────────────────────────────────
AI_PROVIDER=ollama
OLLAMA_MODEL=llama3
