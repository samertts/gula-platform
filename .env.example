# GULA Platform - Environment Configuration Example
# Copy to .env and fill in your values
# WARNING: Never commit .env to version control

# Security
SECRET_KEY=change-me-to-a-random-secret-key
REFRESH_TOKEN_SECRET=change-me-to-a-random-refresh-secret
ENCRYPTION_KEY=change-me-to-a-32-byte-base64-key
NID_HMAC_KEY=change-me-to-a-random-hex-key

# Database
POSTGRES_PASSWORD=change-me-to-a-secure-password

# Redis
REDIS_PASSWORD=change-me-to-a-secure-password

# Supabase (optional, for legacy integration)
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Application
ENV=development
# Public accounts are created only through approved onboarding by default.
PUBLIC_SELF_REGISTRATION_ENABLED=false
# Demo mode must run only with a dedicated synthetic database/Redis deployment.
DEMO_MODE=false
# Set true only for a dedicated synthetic database/Redis deployment.
DEMO_DATA_ISOLATION_ACK=false
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
BASE_URL=http://localhost:3000

# Free/self-hosted operational notifications (enabled with: docker compose --profile monitoring up -d)
# The default URL points to the local ntfy container; set a token only when auth is enabled.
NTFY_BASE_URL=http://ntfy:80
NTFY_TOPIC=gula-ops
NTFY_TOKEN=

# Patient-facing notification channels. These were read by
# shared/notifications/sender.py but documented nowhere, so every deployment
# ran with all three empty (IA-076). An empty value is now an honest refusal:
# the channel returns a delivery failure instead of reporting success, and
# account verification codes sent over it will not reach the user. Leave them
# empty only if you accept that — /auth/verification/request still works in
# non-production, where it returns the code in the response.
# Self-hosted first, per PROGRAM-CONSTITUTION-001: SMTP_HOST can point at a
# local Postfix/Mailu container, and SMS_API_URL at any HTTP gateway that
# accepts {"to", "text", "sender"} with a Bearer key.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_USE_TLS=true
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Public application update policy (metadata only; no secrets)
GULA_RELEASE_NOTES_URL=https://github.com/samertts/gula-platform/releases
GULA_WEB_LATEST_VERSION=2.5.0
GULA_WEB_MINIMUM_SUPPORTED_VERSION=2.5.0
GULA_ANDROID_LATEST_VERSION=2.5.0
GULA_ANDROID_MINIMUM_SUPPORTED_VERSION=2.5.0
GULA_IOS_LATEST_VERSION=2.5.0
GULA_IOS_MINIMUM_SUPPORTED_VERSION=2.5.0
GULA_IOS_STORE_URL=https://github.com/samertts/gula-platform/releases
GULA_WINDOWS_LATEST_VERSION=2.5.0
GULA_WINDOWS_MINIMUM_SUPPORTED_VERSION=2.5.0
GULA_MACOS_LATEST_VERSION=2.5.0
GULA_MACOS_MINIMUM_SUPPORTED_VERSION=2.5.0
GULA_LINUX_LATEST_VERSION=2.5.0
GULA_LINUX_MINIMUM_SUPPORTED_VERSION=2.5.0

# ── AI inference providers ──────────────────────────────────────────────────
# Names only. NEVER put a real key in this file — it is tracked in git.
# Put real values in .env, which is gitignored (.gitignore line 2).
#
# app/ai_fabric/gateway.py registers 8 providers and skips any whose key
# variable is unset, logging "Provider <name> unavailable: credentials not
# configured". Until then the platform runs in stub mode
# ("No AI API key configured — using stub mode"), so AI features return
# placeholder output rather than failing — check this before trusting any
# AI-derived result in development.
#
# PROGRAM-CONSTITUTION-001 (Local AI First, Zero Paid Dependency) makes
# self-hosted inference the first choice. OLLAMA needs NO key: run it locally
# and set only the base URL below. Reach for a hosted provider second.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# The chat and embedding models to pull. Embeddings need an EMBEDDING model;
# a chat model cannot produce them (IA-074). Both are free and CPU-runnable:
#   ollama pull llama3.2:1b && ollama pull nomic-embed-text
OLLAMA_MODEL=llama3.2:1b
OLLAMA_EMBED_MODEL=nomic-embed-text
#
# Second free, self-hosted option: any server speaking the OpenAI-compatible
# protocol (/v1/models, /v1/chat/completions, /v1/embeddings). One setting
# covers vLLM, llama.cpp's server, LocalAI and text-generation-webui. Used
# only when Ollama is not reachable, and still before any paid provider.
# VLLM_API_KEY is optional — vLLM may be started with --api-key, llama.cpp is
# usually open. A server answering /v1/models with an empty list is running
# but has nothing loaded, and is correctly treated as unavailable.
# LOCAL_AI_BASE_URL=http://localhost:8001
# LOCAL_AI_MODEL=
# LOCAL_AI_EMBED_MODEL=
# GEMINI_API_KEY=
# GEMINI_CLINICAL_MODEL=gemini-2.0-flash
# GEMINI_CHAT_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AZURE_OPENAI_KEY=
# VLLM_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
