# =============================================================================
# GULA Platform - Environment Variables Template
# Copy to .env and fill in production values
# =============================================================================

# --- Database ---
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql://postgres:CHANGE_ME@pgbouncer:5432/labdb

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# --- RabbitMQ ---
RABBITMQ_USER=gula
RABBITMQ_PASS=CHANGE_ME_RABBIT_PASSWORD

# --- MinIO Object Storage ---
MINIO_ROOT_USER=gula_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_PASSWORD

# --- Vault ---
VAULT_TOKEN=CHANGE_ME_VAULT_TOKEN

# --- Application Security ---
SECRET_KEY=CHANGE_ME_GENERATE_WITH_python3_-c_"import_secrets;print(secrets.token_urlsafe(64))"
ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_python3_-c_"from_cryptography.fernet_import_Fernet;print(Fernet.generate_key().decode())"

# --- CORS ---
CORS_ORIGINS=https://gula-platform.org,http://gula-platform.org

# --- Master Admin ---
GULA_ADMIN_EMAIL=admin@gula-platform.org
GULA_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
GULA_ADMIN_NAME=GULA Admin

# --- Platform ---
BASE_URL=https://gula-platform.org

# --- Monitoring ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# --- AI ---
AI_PROVIDER=ollama
OLLAMA_MODEL=llama3
