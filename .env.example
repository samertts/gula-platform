# =============================================================================
# GULA Platform v2.1 — Production Environment Template
# منصة غولا الصحية — متغيرات البيئة
#
# SETUP:
#   cp .env.example .env
#   Then fill in every value marked CHANGE_ME
#
# KEY GENERATION COMMANDS:
#   SECRET_KEY        → python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#   REFRESH_TOKEN_SECRET → python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#   ENCRYPTION_KEY    → python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   NID_HMAC_KEY      → python3 -c "import secrets; print(secrets.token_hex(32))"
#   DEVICE_HMAC_KEY   → python3 -c "import secrets; print(secrets.token_hex(32))"
#   Passwords         → python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# =============================================================================

# ── Environment ──────────────────────────────────────────────────────────────
ENV=production

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_POSTGRES_PASSWORD@postgres:5432/labdb

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis:6379

# ── JWT Secrets ───────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_run_python_secrets_token_urlsafe_64
REFRESH_TOKEN_SECRET=CHANGE_ME_run_python_secrets_token_urlsafe_64
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_EXPIRE_MINUTES=30

# ── Encryption ────────────────────────────────────────────────────────────────
# Fernet symmetric key — DO NOT CHANGE after first data is stored.
ENCRYPTION_KEY=CHANGE_ME_run_Fernet_generate_key

# ── National ID HMAC ──────────────────────────────────────────────────────────
# Stable HMAC key for NID hashing — DO NOT CHANGE after first registration.
NID_HMAC_KEY=CHANGE_ME_run_secrets_token_hex_32

# ── Lab Device HMAC ───────────────────────────────────────────────────────────
DEVICE_HMAC_KEY=CHANGE_ME_run_secrets_token_hex_32
# Comma-separated whitelist of analyzer IDs (empty = allow all)
ALLOWED_DEVICE_IDS=

# ── Admin Bootstrap ───────────────────────────────────────────────────────────
GULA_ADMIN_EMAIL=admin@gula-platform.org
GULA_ADMIN_NAME=GULA Platform Admin
GULA_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
# Pre-hashed alternative (takes priority):
# GULA_ADMIN_PASSWORD_HASH=

# ── Platform ──────────────────────────────────────────────────────────────────
BASE_URL=https://gula-platform.org
CORS_ORIGINS=https://gula-platform.org,http://gula-platform.org
ENABLE_API_DOCS=false

# ── Concurrency & Performance ─────────────────────────────────────────────────
# Rule: WEB_CONCURRENCY × (DB_POOL_SIZE + DB_MAX_OVERFLOW) < max_connections (100)
# 4 GB / 2 vCPU → 3 workers × (6+12) = 54 connections (tuned for gula-core-server)
WEB_CONCURRENCY=3
DB_POOL_SIZE=6
DB_MAX_OVERFLOW=12
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
MAX_CONCURRENT_REQUESTS=50
MAX_REQUEST_BODY_MB=2

# ── Push Notifications (optional) ────────────────────────────────────────────
FCM_SERVER_KEY=
APNS_KEY=

# ── PostgreSQL Memory Tuning ─────────────────────────────────────────────────
# 4 GB RAM → 512MB shared_buffers (25% of container cap)
PG_SHARED_BUFFERS=512MB

# ── Docker Resource Limits (gula-core-server: 4 GB RAM / 2 vCPU) ─────────────
# Memory budget: PG 896m + Backend 1536m + Redis 320m + nginx ~128m + OS ~400m = ~3.3 GB
# Backend: 1.5 GB RAM limit, 1.5 CPU (3 uvicorn workers ~120 MB each)
BACKEND_MEM_LIMIT=1536m
BACKEND_CPUS=1.5
# PostgreSQL: 896 MB RAM, 1.0 CPU
PG_MEM_LIMIT=896m
PG_CPUS=1.0

# ── Monitoring (docker compose --profile monitoring up) ──────────────────────
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# ── Health Alerting ──────────────────────────────────────────────────────────
# Webhook URL to POST when /health/deep grade changes (Telegram, Discord, Slack)
# Leave empty to disable alerts
# Telegram example: https://api.telegram.org/bot<TOKEN>/sendMessage?chat_id=<CHAT_ID>
ALERT_WEBHOOK_URL=
# Seconds between health checks (default: 60)
HEALTH_ALERT_INTERVAL_SECONDS=60

# ── Sentry Error Tracking ──────────────────────────────────────────────────────
# Leave empty to disable. Get DSN at https://sentry.io (free tier covers small labs)
SENTRY_DSN=
# Sample rate for performance traces (0.05 = 5% of requests)
SENTRY_TRACES_RATE=0.05
ENVIRONMENT=production

# ── AI Result Interpretation (free, optional) ────────────────────────────────
# Enables the "تفسير ذكي" button on the public result page (/r/{token}).
#
# Provider fallback chain (automatic):
#   Ollama (local, if enabled) → OpenRouter (Qwen/DeepSeek) → Gemini → Groq
#
# On 4 GB / 2 vCPU servers: set OLLAMA_ENABLED=false and use OpenRouter instead.
# OpenRouter gives access to Qwen3-14b and DeepSeek-R1 for FREE — no RAM cost.
#
# Option A: Ollama (local, unlimited, no API key — but uses 2–4 GB RAM)
#   Best for: dedicated AI server or servers with 8+ GB RAM.
#   Install: curl -fsSL https://ollama.com/install.sh | sh
#   Pull model: ollama pull llama3.2:3b   (2.0 GB — good Arabic support)
#   For best Arabic quality: ollama pull aya:8b  (4.8 GB, requires 8+ GB RAM)
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CLINICAL_MODEL=llama3.2:3b
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=20
#
# Option B: OpenRouter (RECOMMENDED for 4 GB servers — free, no RAM cost)
#   Free models with strong Arabic support:
#     qwen/qwen3-14b:free      — best Arabic quality, 14B parameters
#     deepseek/deepseek-r1:free — strong reasoning, good Arabic
#     qwen/qwen3-8b:free       — faster, lighter alternative
#   Get free key (no credit card): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-14b:free
#
# Option C: Google Gemini Flash (cloud fallback)
#   Free tier: 15 req/min, 1,500 req/day, no credit card needed
#   Get key: https://aistudio.google.com/apikey  (free Google account)
GEMINI_API_KEY=
#
# Option D: Groq (cloud fallback — ultra-fast Llama 3)
#   Free tier: 30 req/min, no credit card needed
#   Get key: https://console.groq.com/keys  (free account)
GROQ_API_KEY=
#
# Override auto-detection: "ollama" | "openrouter" | "gemini" | "groq" | "none"
# Leave empty to auto-detect (Ollama first if enabled+reachable, then cloud)
AI_PROVIDER=

# AI response cache TTL in seconds (default: 7200 = 2 hours)
# Same test panel → same cached Arabic interpretation → zero API cost on repeat requests
AI_CACHE_TTL_SECONDS=7200

# Hard budget for the entire AI provider chain (seconds, default: 6.0)
# If Ollama + retries + fallback together exceed this, the request returns 503
# rather than hanging a worker for 30–60s. Tune up if providers are consistently slow.
AI_BUDGET_SECONDS=6.0

# ── Prometheus Metrics Security ──────────────────────────────────────────────
# Optional Bearer token protecting GET /metrics/prom (leave empty to disable in dev)
METRICS_BEARER_TOKEN=CHANGE_ME_run_python_secrets_token_urlsafe_32

# ── Rate Limiting ────────────────────────────────────────────────────────────
# Duration (seconds) to hard-block an IP after 5× rate limit breach (default 3600 = 1h)
RATE_LIMIT_BLOCK_DURATION_SECONDS=3600

# ── Control Layer ─────────────────────────────────────────────────────────────
# Enable the policy engine + decision guard + kill switch (default: true)
CONTROL_LAYER_ENABLED=true

# Kill switch — set to "true" to immediately halt all autonomous AI/repair actions
# Can also be activated at runtime: POST /admin/kill-switch/activate
# Or via Redis: redis-cli SET gula:kill_switch 1
KILL_SWITCH=false

# Self-Audit operating mode — production always forces report_only
# Set ENV=development and GULA_AUTO_FIX=true to allow auto-fix in dev
GULA_AUTO_FIX=false

# Claude API key for the self-audit agent
ANTHROPIC_API_KEY=

# Claude model for self-audit (default: claude-sonnet-4-6)
GULA_AUDIT_MODEL=claude-sonnet-4-6

# Auto-repair thresholds (milliseconds / MB)
REPAIR_MEMORY_WARN_MB=600
REPAIR_MEMORY_CRITICAL_MB=900
REPAIR_DB_LATENCY_WARN=300
REPAIR_POLL_SECS=30

# ── Billing & Payments ────────────────────────────────────────────────────────
# ZainCash payment gateway
ZAINCASH_URL=https://api.zaincash.iq/transaction/pay
ZAINCASH_SECRET=

# QiCard payment gateway
QICARD_URL=https://payment.qi.iq/api/pay
QICARD_SECRET=

# Billing rules
AI_COST_PER_CALL_IQD=50      # IQD charged per AI interpretation
REFERRAL_COMMISSION_RATE=0.10 # 10% referral commission
